<%# The reading-width choice beside a full text's heading, and in a law's
    article toolbar (shared/_reading_styles, reading_width_controller.js).
    Hidden until the controller connects, and by the styles below 48rem. Three
    toggle buttons (owner's requirement of 2026-11-07): the pressed one is the
    width in use; Full screen is the page's reading width, not the browser's
    full-screen mode. %>
<% labels = case I18n.locale
            when :fr then { group: 'Largeur de lecture', full: 'Plein écran', wide: 'Large', comfortable: 'Confortable' }
            when :de then { group: 'Lesebreite', full: 'Vollbild', wide: 'Breit', comfortable: 'Bequem' }
            when :en then { group: 'Reading width', full: 'Full screen', wide: 'Wide', comfortable: 'Comfortable' }
            else { group: 'Leesbreedte', full: 'Volledig scherm', wide: 'Breed', comfortable: 'Comfortabel' }
            end %>
<div class="reading-width-control items-center gap-1 text-xs" role="group" aria-label="<%= labels[:group] %>" data-reading-width-target="control" hidden>
  <span class="text-gray-500 dark:text-gray-400 mr-1" aria-hidden="true"><%= labels[:group] %></span>
  <% %i[full wide comfortable].each do |width| %>
    <button type="button"
            class="px-2 py-1 rounded-md border border-(--accent-500)/20 text-(--accent-700) dark:text-(--accent-400) hover:bg-(--accent-500)/10 aria-pressed:bg-(--accent-500)/15 aria-pressed:font-semibold focus:outline-hidden focus-visible:ring-2 focus-visible:ring-(--accent-500)"
            aria-pressed="<%= width == :full %>"
            data-reading-width-target="option"
            data-reading-width-width-param="<%= width %>"
            data-action="reading-width#choose"><%= labels[width] %></button>
  <% end %>
</div>
