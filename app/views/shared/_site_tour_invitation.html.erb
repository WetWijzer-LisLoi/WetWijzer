<div hidden data-site-tour-target="invitation" data-site-tour-invitation class="site-tour-invitation my-5 rounded-xl border border-(--accent-200) bg-(--accent-50) px-4 py-4 text-center dark:border-(--accent-700)/60 dark:bg-(--accent-950)/30">
  <p class="text-sm font-semibold text-gray-800 dark:text-gray-100"><%= t('site_tour.entry') %></p>
  <div class="mt-3 flex items-center justify-center gap-2">
    <button type="button" hidden class="inline-flex min-h-11 items-center rounded-lg bg-(--accent-600-solid) px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-(--accent-700-solid) focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--accent-500)" data-site-tour-target="opener" data-action="site-tour#open"><%= t('site_tour.entry_button') %></button>
    <button type="button" hidden class="inline-flex min-h-11 w-11 items-center justify-center rounded-lg border border-gray-300 text-xl font-semibold text-gray-700 hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--accent-500) dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800" data-site-tour-dismiss data-action="site-tour#dismissInvitation" aria-label="<%= t('site_tour.close') %>" title="<%= t('site_tour.close') %>"><span aria-hidden="true">×</span></button>
  </div>
</div>
