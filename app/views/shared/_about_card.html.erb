<%# ── About Byline - compact founder credit with expandable bio ──
     Used on homepage (hero) and chatbot page.
     Params:
       variant: :hero (centered, under title) | :sidebar (left-aligned, chatbot page)
%>
<% variant = local_assigns.fetch(:variant, :hero) %>
<%# Professional title, per locale. NL "Mr." is the Belgian legal title
    (Meester); FR uses "Me" (Maitre) and DE "RA" (Rechtsanwalt), matching the
    dedicated legal pages. Hardcoding "Mr." showed the Dutch title to French
    and German readers. %>
<% founder_title = case I18n.locale when :fr then 'Me' when :de then 'RA' else 'Mr.' end %>
<% is_hero = variant == :hero %>

<%# ── Byline row: photo + name + title + expand toggle ── %>
<div class="<%= is_hero ? 'max-w-3xl mx-auto' : '' %>">
  <details class="about-byline group" id="about-byline-details">
    <summary class="flex items-center gap-3 cursor-pointer select-none list-none
                    <%= is_hero ? 'justify-center py-2' : 'py-1.5' %>
                    focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--accent-500)"
             style="list-style: none;">
      <%# Remove default marker %>
      <style nonce="<%= content_security_policy_nonce %>">
        .about-byline summary::-webkit-details-marker { display: none; }
        .about-byline summary::marker { display: none; content: ''; }
      </style>

      <%# Gold-ring photo - small inline %>
      <div class="flex-shrink-0">
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full p-[1.5px] transition-transform duration-300 group-hover:scale-110"
             style="background: linear-gradient(135deg, #c9a962, #e8d5a3, #c9a962);">
          <img src="/images/gauthier-berth.jpg"
               alt=""
               class="w-full h-full rounded-full object-cover border-[1.5px] border-white dark:border-gray-800"
               loading="lazy">
        </div>
      </div>

      <%# Name + title - single line %>
      <div class="flex items-center gap-1.5 flex-wrap min-w-0">
        <span class="text-sm font-semibold text-gray-800 dark:text-gray-200 whitespace-nowrap"><%= founder_title %> Gauthier Berth</span>
        <span class="text-[11px] text-gray-400 dark:text-gray-500 hidden sm:inline">·</span>
        <span class="text-[11px] font-medium whitespace-nowrap hidden sm:inline" style="color: var(--accent-text);">
          <%= case I18n.locale
              when :fr then 'Avocat · Fondateur'
              when :de then 'Rechtsanwalt · Gründer'
              when :en then 'Attorney · Founder'
              else 'Advocaat · Oprichter'
              end %>
        </span>
      </div>

      <%# Expand chevron %>
      <svg class="w-3.5 h-3.5 text-gray-400 dark:text-gray-500 transition-transform duration-200 group-open:rotate-180 flex-shrink-0"
           fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </summary>

    <%# The summary is the identity header in both states. Expand only the
        biography beneath it: no second portrait/name or nested profile card. %>
    <div class="about-bio <%= is_hero ? 'max-w-2xl mx-auto' : '' %> mt-3 pt-3 border-t border-gray-200 dark:border-gray-700 text-left text-sm leading-relaxed text-gray-600 dark:text-gray-300 space-y-2">
      <% case I18n.locale %>
      <% when :fr %>
        <p>J'ai créé <%= site_name %> pour rendre le droit belge accessible à tous. Le site contient <strong>+350.000 articles de loi</strong>, <strong>+175.000 arrêts</strong> et <strong>+100.000 documents parlementaires</strong> - consultables gratuitement et complétés par un chatbot IA qui répond dans <strong>toutes les langues</strong>.</p>
        <p><strong>Pour qui?</strong> Citoyens, étudiants en droit, journalistes, entrepreneurs et professionnels juridiques.</p>
      <% when :de %>
        <p>Ich habe <%= site_name %> entwickelt, um belgisches Recht für alle zugänglich zu machen. Die Website enthält <strong>+350.000 Gesetzesartikel</strong>, <strong>+175.000 Urteile</strong> und <strong>+100.000 parlamentarische Dokumente</strong> - kostenlos durchsuchbar und ergänzt durch einen KI-Chatbot, der in <strong>allen Sprachen</strong> antwortet.</p>
        <p><strong>Für wen?</strong> Bürger, Jurastudenten, Journalisten, Unternehmer und juristische Fachkräfte.</p>
      <% when :en %>
        <p>I created <%= site_name %> to make Belgian law accessible to everyone. The site contains <strong>+350,000 legal articles</strong>, <strong>+175,000 court decisions</strong> and <strong>+100,000 parliamentary documents</strong> - searchable for free and complemented by an AI chatbot that responds in <strong>any language</strong>.</p>
        <p><strong>Who is it for?</strong> Citizens, law students, journalists, entrepreneurs and legal professionals.</p>
      <% else %>
        <p>Ik heb <%= site_name %> gebouwd om het Belgisch recht toegankelijk te maken voor iedereen. De website bevat <strong>+350.000 wetsartikelen</strong>, <strong>+175.000 rechterlijke uitspraken</strong> en <strong>+100.000 parlementaire documenten</strong> - gratis doorzoekbaar en aangevuld met een AI-chatbot die in <strong>elke taal</strong> antwoordt.</p>
        <p><strong>Voor wie?</strong> Burgers, rechtenstudenten, journalisten, ondernemers en juridische professionals.</p>
      <% end %>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-1 text-xs">
        <a href="<%= about_path %>" class="underline underline-offset-2 hover:text-(--accent-text) transition-colors">
          <%= case I18n.locale when :fr then 'En savoir plus →' when :de then 'Mehr erfahren →' when :en then 'Learn more →' else 'Meer info →' end %>
        </a>
        <a href="https://www.advocaat.be/nl/zoek-een-advocaat/advocaat/63fee2a5-637a-4839-a5a6-c833482f1e3a"
           target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-(--accent-text) transition-colors">advocaat.be</a>
        <a href="https://www.linkedin.com/in/gauthier-b-017447138/"
           target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-(--accent-text) transition-colors">LinkedIn</a>
      </div>
    </div>
  </details>
</div>
