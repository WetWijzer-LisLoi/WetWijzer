<% site_tour_steps = t('site_tour.steps').map(&:stringify_keys) %>
<% site_tour_site_name = t(:app_title) %>
<% classic_mode = local_assigns.fetch(:classic_mode, false) %>
<% site_tour_targets = {
     'route' => '#hero-chat-question',
     'search' => '#filters-panel',
     'legislation' => '#popular-laws-tab-0',
     'case_law' => '#popular-laws-tab-2',
     'parliamentary' => '#popular-laws-tab-3',
     'chatbot_draft' => '#hero-sample-questions',
     'chatbot_depth' => '#hero-chat-input [data-research-depth-control]',
     'chatbot_model' => '#hero-model-select',
     'chatbot_sources' => '#hero-settings-panel',
     'chatbot_answers' => '#hero-chatbot-icon-btn',
     'chatbot_privacy' => '[data-tour="help"] a[href^="/privacy-policy"]',
     'bookmarks' => '[data-tour="bookmarks"]',
     'account' => '[data-tour="account"]',
     'pricing' => '[data-tour="pricing"]',
     'security' => '[data-tour="security"]',
     'appearance' => '[data-tour="appearance"] [data-theme-selector-target="panel"]',
     'help' => '[data-tour="help"]'
   } %>
<section id="site-tour-guide" class="site-tour" data-site-tour-homepage-url="<%= root_path(locale: I18n.locale) %>">
  <%# Functional without JavaScript; summary remains a visible close control while open. %>
  <details class="site-tour-fallback mt-3 rounded-lg border border-gray-200 p-3 text-left dark:border-gray-700">
    <summary class="cursor-pointer font-semibold text-(--accent-700) dark:text-(--accent-400)">
      <span class="site-tour-fallback-open"><%= t('site_tour.open') %>: <%= t('site_tour.title', site_name: site_tour_site_name) %></span>
      <span class="site-tour-fallback-close"><span aria-hidden="true">×</span> <%= t('site_tour.close') %></span>
    </summary>
    <p class="mt-3 text-sm text-gray-600 dark:text-gray-300"><%= t('site_tour.fallback_intro') %></p>
    <% site_tour_steps.each_with_index do |step, index| %>
      <details class="mt-2 rounded border border-gray-200 p-2 dark:border-gray-700" data-site-tour-step="<%= step.fetch('id') %>">
        <summary class="cursor-pointer font-medium"><%= index + 1 %>. <%= step['title'] %></summary>
        <p class="mt-2 text-sm leading-6 text-gray-700 dark:text-gray-200"><%= step['body'] %></p>
        <% if step['guidance'].present? %>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-gray-700 dark:text-gray-200">
            <% step['guidance'].each do |detail| %><li><%= detail %></li><% end %>
          </ul>
        <% end %>
      </details>
    <% end %>
  </details>

  <% unless classic_mode %>
  <dialog class="site-tour-dialog m-auto w-screen max-w-none border-0 bg-transparent p-0 text-gray-900 shadow-none dark:bg-transparent dark:text-gray-100" aria-labelledby="site-tour-title" data-site-tour-target="dialog" data-action="close->site-tour#closed cancel->site-tour#cancel keydown->site-tour#keydown">
    <div class="site-tour-spotlight" data-site-tour-target="spotlight" hidden aria-hidden="true"></div>
    <div class="site-tour-card fixed left-1/2 top-1/2 z-10 max-h-[calc(100dvh_-_1rem)] w-[calc(100%_-_1rem)] max-w-lg overflow-y-auto rounded-xl border border-gray-200 bg-white p-0 text-gray-900 shadow-2xl dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100" data-site-tour-target="card">
    <div class="sticky top-0 z-10 flex min-h-14 items-center justify-between gap-3 border-b border-gray-200 bg-white px-3 py-2 dark:border-gray-700 dark:bg-gray-900">
      <h2 id="site-tour-title" class="text-base font-bold"><%= t('site_tour.title', site_name: site_tour_site_name) %></h2>
      <button type="button" class="inline-flex min-h-10 shrink-0 items-center gap-1 rounded-md border border-gray-300 px-3 py-2 text-sm font-semibold hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--accent-500) dark:border-gray-600 dark:hover:bg-gray-800" title="<%= t('site_tour.close') %>" aria-label="<%= t('site_tour.close') %>" data-action="site-tour#close"><span aria-hidden="true" class="text-lg leading-none">×</span><span><%= t('site_tour.close') %></span></button>
    </div>
    <div class="px-4 py-4 sm:px-6" data-site-tour-target="body">
      <nav aria-label="<%= t('site_tour.contents') %>" class="mb-3 flex gap-1">
        <ol class="flex flex-wrap gap-1">
          <% site_tour_steps.each_with_index do |step, index| %>
            <li><button type="button" class="flex h-6 w-6 items-center justify-center rounded-full bg-gray-300 text-xs font-semibold text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--accent-500) dark:bg-gray-600 dark:text-white" aria-label="<%= index + 1 %>. <%= step['title'] %>" data-action="site-tour#go" data-site-tour-step="<%= step.fetch('id') %>" data-site-tour-index-param="<%= index %>"><%= index + 1 %></button></li>
          <% end %>
        </ol>
      </nav>
      <% site_tour_steps.each_with_index do |step, index| %>
        <article data-site-tour-target="step" data-site-tour-step="<%= step.fetch('id') %>" data-site-tour-selector="<%= site_tour_targets.fetch(step.fetch('id')) %>" <%= 'hidden' unless index.zero? %>>
          <p class="text-sm font-semibold text-(--accent-700) dark:text-(--accent-400)"><%= t('site_tour.step_counter', current: index + 1, total: site_tour_steps.length) %></p>
          <p hidden class="mt-2 rounded-md bg-gray-100 px-3 py-2 text-xs text-gray-600 dark:bg-gray-800 dark:text-gray-300" data-site-tour-target="targetStatus"><%= t('site_tour.target_unavailable') %></p>
          <h3 class="mt-1 text-xl font-bold"><%= step['title'] %></h3>
          <p class="mt-3 text-sm leading-6 text-gray-700 dark:text-gray-200"><%= step['body'] %></p>
          <% if step['guidance'].present? %>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-gray-700 dark:text-gray-200">
              <% step['guidance'].each do |detail| %><li><%= detail %></li><% end %>
            </ul>
          <% end %>
        </article>
      <% end %>
    </div>
    <div class="flex items-center justify-between gap-3 border-t border-gray-200 bg-white px-4 py-3 dark:border-gray-700 dark:bg-gray-900 sm:px-6">
      <button type="button" class="min-h-11 rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-gray-600 dark:hover:bg-gray-800" data-site-tour-target="previous" data-action="site-tour#previous"><%= t('site_tour.previous') %></button>
      <button type="button" class="min-h-11 rounded-lg bg-(--accent-600-solid) px-4 py-2 text-sm font-semibold text-white hover:bg-(--accent-700-solid)" data-site-tour-target="next" data-site-tour-next-label="<%= t('site_tour.next') %>" data-site-tour-finish-label="<%= t('site_tour.finish') %>" data-action="site-tour#next"><%= t('site_tour.next') %></button>
    </div>
    </div>
  </dialog>
  <% end %>
</section>

<style<% unless classic_mode %> nonce="<%= content_security_policy_nonce %>"<% end %>>
  .site-tour-fallback { display: block; }
  .site-tour:has(dialog[data-site-tour-enhanced]) .site-tour-fallback { display: none; }
  .site-tour-fallback-close { display: none; }
  .site-tour-fallback[open] > summary { position: sticky; top: 0; z-index: 1; display: block; margin: -0.75rem -0.75rem 0; padding: 0.75rem; background: inherit; border-bottom: 1px solid currentColor; }
  .site-tour-fallback[open] .site-tour-fallback-open { display: none; }
  .site-tour-fallback[open] .site-tour-fallback-close { display: inline; }
  .site-tour-dialog::backdrop { background: transparent; }
  .site-tour-dialog { position: fixed; inset: 0; width: 100vw; height: 100vh; max-width: none; max-height: none; overflow: visible; }
  .site-tour-dialog:not(.site-tour-has-target) { background: rgb(0 0 0 / 0.56); }
  /* Use transform, not Tailwind's independent translate property: the
     controller can then override centering with clamped pixel coordinates. */
  .site-tour-card { transform: translate(-50%, -50%); }
  .site-tour-spotlight { position: fixed; z-index: 1; pointer-events: none; border: 2px solid var(--accent-500, #2563eb); border-radius: 0.75rem; box-shadow: 0 0 0 9999px rgb(0 0 0 / 0.56), 0 0 0 0.4rem color-mix(in srgb, var(--accent-500, #2563eb) 35%, transparent); }
  .site-tour-highlight { scroll-margin-block: 7rem; }
  @media (max-width: 640px) { .site-tour-dialog { max-height: calc(100dvh - 1rem); } }
  @media (prefers-reduced-motion: reduce) {
    .site-tour-dialog, .site-tour-dialog::backdrop,
    body:has(.site-tour-dialog[open]) [data-collapse-target="content"],
    body:has(.site-tour-dialog[open]) [data-mobile-menu-target="panel"],
    body:has(.site-tour-dialog[open]) #hero-settings-panel { transition: none !important; }
  }
</style>
