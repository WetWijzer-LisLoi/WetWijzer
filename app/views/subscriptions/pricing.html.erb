        <%= case I18n.locale when :fr then 'Comment ça marche ?' when :de then 'Wie funktioniert es?' when :en then 'How does it work?' else 'Hoe werkt het?' end %>
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="flex justify-center mb-4">
            <svg class="w-10 h-10 text-(--accent-600)" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <h3 class="font-bold text-gray-900 dark:text-white mb-2">1. <%= case I18n.locale when :fr then 'Inscrivez-vous gratuitement' when :de then 'Kostenlos registrieren' when :en then 'Register free' else 'Registreer gratis' end %></h3>
          <p class="text-gray-600 dark:text-gray-400"><%= case I18n.locale when :fr then "#{RegistrationsController::STARTER_CREDITS} crédits de départ" when :de then "#{RegistrationsController::STARTER_CREDITS} Startcredits" when :en then "#{RegistrationsController::STARTER_CREDITS} starter credits" else "#{RegistrationsController::STARTER_CREDITS} startcredits" end %></p>
        </div>
        <div class="text-center">
          <div class="flex justify-center mb-4">
            <svg class="w-10 h-10 text-(--accent-600)" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          </div>
          <h3 class="font-bold text-gray-900 dark:text-white mb-2">2. <%= case I18n.locale when :fr then 'Posez des questions' when :de then 'Fragen stellen' when :en then 'Ask questions' else 'Stel vragen' end %></h3>
          <p class="text-gray-600 dark:text-gray-400"><%= case I18n.locale when :fr then 'Réponses IA sur la législation belge avec sources' when :de then 'KI-Antworten zu belgischer Gesetzgebung mit Quellenangabe' when :en then 'AI answers on Belgian law with source citations' else 'AI-antwoorden over Belgische wetgeving met bronvermelding' end %></p>
        </div>
        <div class="text-center">
          <div class="flex justify-center mb-4">
            <svg class="w-10 h-10 text-(--accent-600)" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
          </div>
          <h3 class="font-bold text-gray-900 dark:text-white mb-2">3. <%= case I18n.locale when :fr then 'Achetez des crédits' when :de then 'Credits kaufen' when :en then 'Buy credits' else 'Koop credits' end %></h3>
          <p class="text-gray-600 dark:text-gray-400"><%= case I18n.locale when :fr then 'Besoin de plus ? Achetez des crédits supplémentaires' when :de then 'Mehr benötigt? Kaufen Sie zusätzliche Credits' when :en then 'Need more? Buy additional credits' else 'Meer nodig? Koop extra credits' end %></p>
        </div>
      </div>
    </div>

    <!-- FAQ -->
    <div class="text-center">
      <p class="text-gray-600 dark:text-gray-400">
        <%= case I18n.locale when :fr then 'Questions ?' when :de then 'Fragen?' when :en then 'Questions?' else 'Vragen?' end %> <a href="mailto:info@wetwijzer.be" class="text-(--accent-600) hover:underline">info@wetwijzer.be</a>
      </p>
    </div>
  </div>
