<%= content_for :title, t('pricing.title') %>
<% pricing_currency_options = { locale: I18n.locale, unit: '€', format: '%u%n', precision: 2,
                                separator: I18n.locale == :en ? '.' : ',',
                                delimiter: I18n.locale == :en ? ',' : '.' } %>
<% pricing_starter_summary, pricing_depth_summary, pricing_depth_details_label, pricing_provider_details_label =
     case I18n.locale
     when :fr
       ['Une fois à l’inscription. Choisissez ensuite une combinaison disponible dans votre solde.',
        'Prix du modèle + 0 / + 1 / + 2 crédits pour le raisonnement pris en charge. La barre et la liste sont liées ; le total exact est affiché avant Envoyer.',
        'Comprendre les choix et les coûts', 'Traitement et modifications']
     when :de
       ['Einmal bei der Registrierung. Wählen Sie danach eine verfügbare Kombination innerhalb Ihres Guthabens.',
        'Modellpreis + 0 / + 1 / + 2 Credits für unterstützten Denkaufwand. Leiste und Auswahlliste sind gekoppelt; die genaue Summe steht vor Senden.',
        'Auswahl und Kosten erklärt', 'Verarbeitung und Änderungen']
     when :en
       ['Once when you register. Then choose an available combination within your balance.',
        'Model price + 0 / + 1 / + 2 credits for supported reasoning. The bar and dropdown are linked; the exact total is shown before Send.',
        'About choices and costs', 'Processing and changes']
     else
       ['Eenmalig bij registratie. Kies daarna een beschikbare combinatie binnen uw saldo.',
        'Modelprijs + 0 / + 1 / + 2 credits voor ondersteund denkwerk. Balk en keuzelijst zijn gekoppeld; het exacte totaal staat vóór Verzenden.',
        'Uitleg over keuzes en kosten', 'Verwerking en wijzigingen']
     end %>

<div class="ww-pricing-page min-h-screen bg-gray-50 dark:bg-gray-900 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-5xl mx-auto">
    <% if flash[:alert] || flash[:error] %>
      <div class="mb-8 p-4 rounded-lg bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200 flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" /></svg>
        <span class="text-sm font-medium"><%= flash[:alert] || flash[:error] %></span>
      </div>
    <% end %>
    <% if flash[:notice] %>
      <div class="mb-8 p-4 rounded-lg bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 text-green-800 dark:text-green-200 flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span class="text-sm font-medium"><%= flash[:notice] %></span>
      </div>
    <% end %>
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
        <%= t('pricing.title') %>
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-400">
        <%= case I18n.locale
            when :fr then 'Commencez gratuitement. Achetez des crédits ou choisissez Pro.'
            when :de then 'Starten Sie kostenlos. Kaufen Sie Credits oder wählen Sie Pro.'
            when :en then 'Start free. Buy credits or subscribe for more.'
            else 'Start gratis. Koop credits of neem een abonnement voor meer.'
            end %>
      </p>
    </div>

    <!-- Starter Credits Banner -->
    <div class="ww-pricing-starter bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 rounded-2xl p-6 mb-12 text-center">
      <div class="flex items-center justify-center gap-3 mb-2">
        <svg class="w-8 h-8 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/></svg>
        <h2 class="text-2xl font-bold text-green-800 dark:text-green-200">
          <%= case I18n.locale
              when :fr then "#{RegistrationsController::STARTER_CREDITS} crédits de bienvenue gratuits"
              when :de then "#{RegistrationsController::STARTER_CREDITS} kostenlose Willkommenscredits"
              when :en then "#{RegistrationsController::STARTER_CREDITS} free starter credits"
              else "#{RegistrationsController::STARTER_CREDITS} gratis startcredits"
              end %>
        </h2>
      </div>
      <p data-testid="pricing-starter-explanation" class="text-green-700 dark:text-green-300">
        <%= pricing_starter_summary %>
      </p>
      <% unless logged_in? %>
        <%= link_to signup_path, class: "ww-pricing-cta inline-block mt-4 px-6 py-3 bg-green-700 text-white font-semibold rounded-lg hover:bg-green-800 transition" do %>
          <%= case I18n.locale
              when :fr then 'Inscription gratuite'
              when :de then 'Kostenlos registrieren'
              when :en then 'Register free'
              else 'Gratis registreren'
              end %> &rarr;
        <% end %>
      <% end %>
    </div>

    <!-- Two-column: Credit Packs + Pro Subscription -->
    <div class="grid lg:grid-cols-2 gap-8 mb-16">
      
      <!-- LEFT: Credit Packs -->
      <div class="flex flex-col">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
          <%= case I18n.locale
              when :fr then 'Packs de crédits'
              when :de then 'Credit-Pakete'
              when :en then 'Credit packs'
              else 'Creditpakketten'
              end %>
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6 text-sm">
          <%= case I18n.locale
              when :fr then 'Achetez des crédits et utilisez-les quand vous voulez.'
              when :de then 'Kaufen Sie Credits und nutzen Sie sie wann Sie wollen.'
              when :en then 'Buy credits and use them whenever you want.'
              else 'Koop credits en gebruik wanneer u wilt.'
              end %>
        </p>
        
        <div class="flex flex-col justify-between gap-4 flex-1">
          <% CreditPurchase::PACKAGES.each do |key, info| %>
            <div data-testid="pricing-credit-package" data-package="<%= key %>" class="ww-pricing-card bg-white dark:bg-gray-800 rounded-xl shadow p-5 border border-gray-200 dark:border-gray-700 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:shadow-lg transition">
              <div>
                <h3 class="font-bold text-gray-900 dark:text-white">
                  <%= t("credits.packages.#{key}.name") %>
                </h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  <span data-testid="pricing-package-credits"><%= chatbot_credit_range(info[:credits]) %></span>
                  <span data-testid="pricing-per-credit" class="text-xs text-gray-500">
                    (<%= number_to_currency(info[:price_cents].to_d / info[:credits] / 100, **pricing_currency_options) %>/cr)
                  </span>
                </p>
              </div>
              <div data-testid="pricing-credit-action" class="pricing-credit-action">
                <div data-testid="pricing-package-price" class="text-2xl font-bold text-(--accent-600) mb-0.5">
                  <%= number_to_currency(info[:price_cents].to_d / 100, **pricing_currency_options) %>
                </div>
                <% if info[:pro_price_cents] && info[:pro_price_cents] < info[:price_cents] %>
                  <div data-testid="pricing-package-pro-price" class="ww-pricing-discount text-xs text-green-700 dark:text-green-400 font-semibold">
                    Pro: <%= number_to_currency(info[:pro_price_cents].to_d / 100, **pricing_currency_options) %>
                  </div>
                <% end %>
                <% if logged_in? %>
                  <div class="flex flex-col gap-1 mt-2">
                    <%= button_to credits_purchase_path(package: key), method: :post, form: { class: "w-full", data: { turbo: false } }, class: "inline-flex w-full items-center justify-center px-4 py-2 text-sm rounded-lg bg-(--accent-600-solid) text-white font-semibold hover:bg-(--accent-700-solid) transition" do %>
                      <%= case I18n.locale when :fr then 'Acheter' when :de then 'Kaufen' when :en then 'Buy' else 'Kopen' end %>
                    <% end %>
                    <% if ENV['COINGATE_API_TOKEN'].present? %>
                      <%= button_to credits_crypto_purchase_path(package: key), method: :post, form: { class: "w-full", data: { turbo: false } }, class: "inline-flex w-full items-center justify-center gap-1 px-4 py-1.5 text-xs rounded-lg bg-amber-500 text-gray-900 font-semibold hover:bg-amber-600 transition" do %>
                        ₿ Crypto
                      <% end %>
                    <% end %>
                  </div>
                <% else %>
                  <%= link_to signup_path, class: "ww-pricing-secondary-cta inline-flex w-full sm:w-auto items-center justify-center mt-2 px-4 py-2 text-sm rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-semibold hover:bg-gray-300 dark:hover:bg-gray-600 transition" do %>
                    <%= case I18n.locale when :fr then "S'inscrire" when :de then 'Registrieren' when :en then 'Sign up' else 'Registreren' end %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        </div>

      <!-- RIGHT: Pro Subscription -->
      <div class="flex flex-col">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
          WetWijzer Pro
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6 text-sm">
          <%= case I18n.locale
              when :fr then 'Soutenez le projet et profitez d\'avantages exclusifs.'
              when :de then 'Unterstützen Sie das Projekt und genießen Sie exklusive Vorteile.'
              when :en then 'Support the project and enjoy exclusive benefits.'
              else 'Steun het project en geniet van extra voordelen.'
              end %>
        </p>

        <div class="ww-pricing-pro-card bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 border-2 border-(--accent-500) flex-1 flex flex-col">
          <div class="mb-4">
            <!-- Pricing -->
            <div class="flex items-baseline gap-1">
              <span data-testid="pricing-pro-monthly-price" class="text-4xl font-bold text-(--accent-600)"><%= number_to_currency(Subscription::TIER_CONFIG.fetch('pro').fetch(:price_monthly).to_d / 100, **pricing_currency_options) %></span>
              <span class="text-gray-500 dark:text-gray-400">/<%= case I18n.locale when :fr then 'mois' when :de then 'Monat' when :en then 'month' else 'maand' end %></span>
            </div>
          </div>

          <ul class="text-sm text-gray-600 dark:text-gray-400 space-y-3 mb-6">
            <li class="ww-pricing-benefit flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span><strong><%= case I18n.locale when :fr then "#{Subscription::PRO_MONTHLY_CREDITS} crédits/mois" when :de then "#{Subscription::PRO_MONTHLY_CREDITS} Credits/Monat" when :en then "#{Subscription::PRO_MONTHLY_CREDITS} credits/month" else "#{Subscription::PRO_MONTHLY_CREDITS} credits/maand" end %></strong> <%= case I18n.locale when :fr then 'inclus' when :de then 'inklusive' when :en then 'included' else 'inbegrepen' end %></span>
            </li>
            <li class="ww-pricing-benefit flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span data-testid="pricing-pro-model-access"><strong><%= t('chatbot.research_depth.options.extensive.label') %></strong> - <%= case I18n.locale when :fr then 'groupe de modèles Pro, selon disponibilité' when :de then 'Pro-Modellgruppe, nach Verfügbarkeit' when :en then 'Pro model group, subject to availability' else 'Pro-modelgroep, volgens beschikbaarheid' end %></span>
            </li>

            <li class="ww-pricing-benefit flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span><strong><%= case I18n.locale when :fr then 'Réduction 30%' when :de then '30% Rabatt' when :en then '30% discount' else '30% korting' end %></strong> - <%= case I18n.locale when :fr then 'sur les packs de crédits supplémentaires' when :de then 'auf zusätzliche Credit-Pakete' when :en then 'on extra credit packs' else 'op extra creditpakketten' end %></span>
            </li>
            <li class="ww-pricing-benefit flex items-center gap-2">
              <svg class="w-4 h-4 text-red-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
              <span><strong><%= case I18n.locale when :fr then 'Soutenez WetWijzer' when :de then 'Unterstützen Sie WetWijzer' when :en then 'Support WetWijzer' else 'Steun WetWijzer' end %></strong> - <%= case I18n.locale when :fr then 'aidez-nous à rester indépendant et gratuit' when :de then 'helfen Sie uns unabhängig und kostenlos zu bleiben' when :en then 'help us stay independent and free' else 'help ons onafhankelijk en gratis te blijven' end %></span>
            </li>
          </ul>

          <!-- AI Availability Disclaimer -->
          <div class="ww-pricing-availability-notice mt-auto mb-4 p-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg">
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
              <p class="text-[11px] text-amber-700 dark:text-amber-300 leading-relaxed">
                <%= case I18n.locale
                    when :fr then 'Les fonctionnalités IA dépendent de fournisseurs tiers (OpenAI, Anthropic, Mistral). La disponibilité et les prix peuvent changer sans préavis. Voir nos conditions d\'utilisation (§8.1b).'
                    when :de then 'KI-Funktionen hängen von Drittanbietern ab (OpenAI, Anthropic, Mistral). Verfügbarkeit und Preise können sich ohne Vorankündigung ändern. Siehe unsere Nutzungsbedingungen (§8.1b).'
                    when :en then 'AI features depend on third-party providers (OpenAI, Anthropic, Mistral). Availability and pricing may change without notice. See our terms of service (§8.1b).'
                    else 'AI-functies zijn afhankelijk van externe providers (OpenAI, Anthropic, Mistral). Beschikbaarheid en prijzen kunnen zonder voorafgaande kennisgeving wijzigen. Zie onze gebruiksvoorwaarden (§8.1b).'
                    end %>
              </p>
            </div>
          </div>

          <div data-testid="pricing-pro-cta" class="pricing-pro-cta">
            <% if logged_in? %>
              <% if current_user.pro? %>
                <%= link_to subscription_path, class: "ww-pricing-cta inline-flex w-full items-center justify-center py-3 px-4 text-center rounded-lg bg-(--accent-600-solid) text-white font-semibold hover:bg-(--accent-700-solid) transition" do %>
                  <%= case I18n.locale when :fr then 'Gérer l’abonnement' when :de then 'Abonnement verwalten' when :en then 'Manage subscription' else 'Abonnement beheren' end %>
                <% end %>
              <% else %>
                <!-- Monthly checkout -->
                <%= button_to checkout_path(tier: 'pro', interval: 'monthly'), method: :post, form: { class: "w-full", data: { turbo: false } }, class: "ww-pricing-cta inline-flex w-full items-center justify-center py-3 px-4 text-center rounded-lg bg-(--accent-600-solid) text-white font-semibold hover:bg-(--accent-700-solid) transition" do %>
                  <%= case I18n.locale when :fr then "S'abonner" when :de then 'Abonnieren' when :en then 'Subscribe' else 'Abonneren' end %>
                <% end %>
                <% if ENV['COINGATE_API_TOKEN'].present? %>
                  <%= button_to crypto_checkout_path(tier: 'pro'), method: :post, form: { class: "w-full mt-2", data: { turbo: false } }, class: "inline-flex w-full items-center justify-center py-2.5 px-4 text-center rounded-lg bg-amber-500 text-gray-900 font-semibold hover:bg-amber-600 transition text-sm" do %>
                    ₿ <%= case I18n.locale when :fr then 'Payer avec Crypto' when :de then 'Mit Krypto bezahlen' when :en then 'Pay with Crypto' else 'Betaal met Crypto' end %>
                  <% end %>
                <% end %>
              <% end %>
            <% else %>
              <%= link_to signup_path, class: "ww-pricing-cta inline-flex w-full items-center justify-center py-3 px-4 text-center rounded-lg bg-(--accent-600-solid) text-white font-semibold hover:bg-(--accent-700-solid) transition" do %>
                <%= case I18n.locale when :fr then 'Inscription gratuite' when :de then 'Kostenlos registrieren' when :en then 'Register free' else 'Gratis registreren' end %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>



    <!-- AI Models & Tiers - Comprehensive Overview -->
    <% pricing_rows = chatbot_pricing_rows(I18n.locale)
       pricing_availability = chatbot_pricing_availability(pricing_rows) %>
    <div class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2 text-center">
        <%= case I18n.locale when :fr then 'Modèles IA par niveau' when :de then 'KI-Modelle pro Stufe' when :en then 'AI models per level' else 'AI-modellen per niveau' end %>
      </h2>
      <p data-testid="pricing-model-availability-summary" class="text-center text-sm text-gray-500 dark:text-gray-400 mb-4">
        <%= pricing_access_copy.fetch(:catalogue) % pricing_availability %>
      </p>
      <p data-testid="pricing-reasoning-explanation" class="text-center text-sm text-gray-500 dark:text-gray-400 mb-8">
        <%= pricing_depth_summary %>
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        <% pricing_rows.each do |row| %>
          <div class="ww-pricing-tier-card bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden" data-intelligence="<%= row.fetch(:id) %>">
            <div class="ww-pricing-tier-header px-6 py-4 bg-gray-50 dark:bg-gray-900/30 border-b border-gray-200 dark:border-gray-700">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div>
                    <h3 class="font-bold text-gray-900 dark:text-white text-lg"><%= row.fetch(:label) %></h3>
                    <p class="text-xs text-gray-500 dark:text-gray-400"><%= row.fetch(:description) %></p>
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-sm font-bold text-gray-700 dark:text-gray-300"><%= chatbot_base_credit_label(row.fetch(:base_credits)) %></div>
                  <% if row.fetch(:pro) %>
                    <span class="inline-flex items-center text-[10px] font-bold px-2 py-0.5 rounded-full bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200">PRO</span>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="px-6 py-4 space-y-3">
              <% row.fetch(:models).each_with_index do |model, index| %>
                <% model_pending = LegalChatbotService::AVAILABLE_MODELS.dig(model.fetch(:id), :deployed) == false %>
                <div data-testid="pricing-model" data-model-id="<%= model.fetch(:id) %>" data-model-available="<%= !model_pending %>" class="flex items-center justify-between py-2 <%= 'border-t border-gray-100 dark:border-gray-700/50' if index.positive? %>">
                  <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-gray-100 dark:bg-gray-700 text-sm font-bold text-gray-700 dark:text-gray-200" aria-hidden="true"><%= model.fetch(:name)[0] %></span>
                    <div>
                      <div class="font-semibold text-sm text-gray-900 dark:text-white"><%= model.fetch(:name) %><% if model.fetch(:preview) %>
                        <span data-testid="pricing-preview-badge" class="block text-[10px] font-normal text-gray-500 dark:text-gray-400"><%= chatbot_pricing_copy.fetch(:preview) %></span>
                      <% end %></div>
                      <% if model_pending %>
                        <span data-testid="pricing-coming-soon-badge" class="block text-[10px] text-gray-500 dark:text-gray-400"><%= t('chatbot.model_coming_soon') %></span>
                      <% end %>
                      <div class="text-xs text-gray-500 dark:text-gray-400 flex items-center gap-1">
                        <span class="inline-block w-3 h-2 rounded-sm bg-gray-500" aria-hidden="true"></span> <%= chatbot_provider_scope_badge(model.fetch(:provider)) %>
                      </div>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <span data-testid="pricing-model-credits" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200"><%= chatbot_base_credit_label(model.fetch(:base_credits)) %></span>
                    <% if model.fetch(:pro) %>
                      <span data-testid="pricing-pro-badge" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200">PRO</span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <p data-testid="pricing-credit-access-explanation" class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">
        <%= pricing_access_copy.fetch(:access) %>
      </p>
      <p data-testid="pricing-source-access-explanation" class="mt-3 text-center text-sm text-gray-500 dark:text-gray-400">
        <%= pricing_access_copy.fetch(:source_access) %>
      </p>
      <% if pricing_availability.fetch(:pending).positive? %>
        <p data-testid="pricing-pending-explanation" class="mt-3 text-center text-sm text-gray-500 dark:text-gray-400">
          <%= pricing_access_copy.fetch(:pending) %>
        </p>
      <% end %>
      <details data-testid="pricing-depth-details" class="mt-4 text-center text-xs text-gray-500 dark:text-gray-400">
        <summary class="cursor-pointer font-medium"><%= pricing_depth_details_label %></summary>
        <p class="mt-2"><%= chatbot_pricing_copy.fetch(:base_credits) %>. <%= chatbot_pricing_copy.fetch(:reasoning_text) % { surcharges: chatbot_reasoning_surcharge_list } %></p>
      </details>
      <details data-testid="pricing-provider-details" class="mt-3 text-center text-[11px] text-gray-500">
        <summary class="cursor-pointer font-medium"><%= pricing_provider_details_label %></summary>
        <p class="mt-2"><%= chatbot_processing_location_summary %></p>
        <p class="mt-2"><%= case I18n.locale
            when :fr then '** Les modèles IA, fournisseurs et coûts en crédits indiqués sont indicatifs et peuvent être modifiés sans préavis. Voir nos conditions d\'utilisation (§8.1b) pour plus de détails.'
            when :de then '** Die angegebenen KI-Modelle, Anbieter und Creditkosten sind indikativ und können ohne vorherige Ankündigung geändert werden. Siehe unsere Nutzungsbedingungen (§8.1b) für Details.'
            when :en then '** The AI models, providers, and credit costs shown are indicative and may be changed without prior notice. See our terms of service (§8.1b) for details.'
            else '** De vermelde AI-modellen, providers en creditkosten zijn indicatief en kunnen zonder voorafgaande kennisgeving worden gewijzigd. Zie onze gebruiksvoorwaarden (§8.1b) voor details.'
            end %></p>
      </details>
    </div>

    <!-- How it works -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-lg mb-16">
