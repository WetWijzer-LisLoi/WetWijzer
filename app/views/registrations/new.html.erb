<%= content_for :title, t('auth.signup') %>

<div class="min-h-screen flex items-start justify-center bg-gray-50 dark:bg-gray-900 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl w-full animate-entrance-stagger">

    <%# ═══════════════════════════════════════════════════════════════════
         TWO-COLUMN LAYOUT: Plans (left) + Form (right)
         On mobile: stacked vertically, plans first
         ═══════════════════════════════════════════════════════════════════ %>
    <div class="text-center mb-8">
      <h1 class="text-3xl font-extrabold text-gray-900 dark:text-white">
        <%= t('auth.signup') %>
      </h1>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <%= t('auth.have_account') %>
        <%= link_to t('auth.login'), login_path, class: "font-medium text-(--accent-600) hover:text-(--accent-500)" %>
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 items-start">

      <%# ── LEFT: Plan comparison ── %>
      <div class="order-2 lg:order-1">
        <h2 id="plan-choice-title" class="text-lg font-bold text-gray-900 dark:text-white text-center lg:text-left">
          <%= case I18n.locale
              when :fr then 'Choisissez votre formule'
              when :de then 'Wählen Sie Ihren Plan'
              when :en then 'Choose your plan'
              else 'Kies uw formule'
              end %>
        </h2>

        <%# 10:49 no-JS plan, C.1: the plans are native radio inputs that the form
            below submits through their form attribute, with or without scripts.
            Each card's label covers the card, so a click anywhere chooses it;
            everything the cards show follows the checked input through CSS
            (:has), so nothing can drift from what is submitted. %>
        <%# Independent auto-sized rows: revealing Pro's confirmation must not
            stretch the Gratis card to the same height. %>
        <fieldset class="grid grid-cols-1 items-start gap-4 min-w-0"
                  aria-labelledby="plan-choice-title">
        <%# ── FREE PLAN ── %>
        <div id="plan-free-card"
             class="relative bg-white dark:bg-gray-800 rounded-xl border-2 border-gray-200 dark:border-gray-700 opacity-60 p-5 shadow-sm transition-all duration-200 hover:shadow-md motion-reduce:transition-none has-[:checked]:border-green-300 dark:has-[:checked]:border-green-700 has-[:checked]:opacity-100 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-4 has-[:focus-visible]:outline-(--accent-600) dark:has-[:focus-visible]:outline-(--accent-400)">
          <label for="plan_free" class="absolute inset-0 rounded-xl cursor-pointer"></label>
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-3">
              <input type="radio" name="plan" value="free" id="plan_free" form="signup_form" checked
                     aria-labelledby="plan-free-name" aria-describedby="plan-free-features"
                     class="relative z-10 w-5 h-5 shrink-0 cursor-pointer border-2 border-gray-300 dark:border-gray-500 dark:bg-gray-700 text-green-600 focus:ring-green-500">
              <div>
                <h3 id="plan-free-name" class="font-bold text-gray-900 dark:text-white text-lg">
                  <%= case I18n.locale when :fr then 'Gratuit' when :de then 'Kostenlos' when :en then 'Free' else 'Gratis' end %>
                </h3>
                <p class="text-2xl font-bold text-green-600 dark:text-green-400">€0
                  <span class="text-sm font-normal text-gray-500 dark:text-gray-400">/<%= case I18n.locale when :fr then 'toujours' when :de then 'immer' when :en then 'forever' else 'altijd' end %></span>
                </p>
              </div>
            </div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300">
              <%= case I18n.locale when :fr then 'PAR DÉFAUT' when :de then 'STANDARD' when :en then 'DEFAULT' else 'STANDAARD' end %>
            </span>
          </div>
          <ul id="plan-free-features" class="text-sm text-gray-600 dark:text-gray-400 space-y-2 ml-8">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span><strong><%= RegistrationsController::STARTER_CREDITS %> <%= case I18n.locale when :fr then 'crédits de bienvenue gratuits' when :de then 'kostenlose Willkommenscredits' when :en then 'free starter credits' else 'gratis startcredits' end %></strong> <%= case I18n.locale when :fr then '(une seule fois)' when :de then '(einmalig)' when :en then '(one-time)' else '(eenmalig)' end %></span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span><%= case I18n.locale when :fr then 'Crédits supplémentaires à l’achat, sans abonnement' when :de then 'Zusätzliche Credits zukaufbar, ohne Abo' when :en then 'Extra credits available to buy, no subscription needed' else 'Extra credits bijkoopbaar, geen abonnement nodig' end %></span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span><%= case I18n.locale when :fr then 'Une sélection de modèles du niveau Malin' when :de then 'Ausgewählte Modelle der Stufe Schlau' when :en then 'Select models of the Smart tier' else 'Geselecteerde modellen van het Slim-niveau' end %></span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-gray-300 dark:text-gray-600 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              <span class="text-gray-500"><%= case I18n.locale when :fr then 'Tous les autres modèles et niveaux = Pro' when :de then 'Alle anderen Modelle und Stufen = Pro' when :en then 'All other models and levels = Pro' else 'Alle andere modellen en niveaus = Pro' end %></span>
            </li>

          </ul>
        </div>

        <%# ── PRO PLAN ── %>
        <div id="plan-pro-card"
             class="group relative bg-white dark:bg-gray-800 rounded-xl border-2 border-(--accent-500) p-5 shadow-lg transition-all duration-200 hover:shadow-xl hover:border-(--accent-400) hover:scale-[1.01] motion-reduce:transition-none motion-reduce:hover:scale-100 has-[:checked]:ring-2 has-[:checked]:ring-(--accent-500) has-[:checked]:shadow-xl has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-4 has-[:focus-visible]:outline-(--accent-600) dark:has-[:focus-visible]:outline-(--accent-400)">
          <label for="plan_pro" class="absolute inset-0 rounded-xl cursor-pointer"></label>
          <div class="absolute -top-3 left-4 pointer-events-none">
            <span class="inline-block bg-(--accent-600-solid) text-white text-[10px] font-bold px-3 py-1 rounded-full capitalize tracking-wider">
              <%= case I18n.locale when :fr then 'Recommandé' when :de then 'Empfohlen' when :en then 'Recommended' else 'Aanbevolen' end %>
            </span>
          </div>
          <div class="flex items-center justify-between mb-3 mt-1">
            <div class="flex items-center gap-3">
              <input type="radio" name="plan" value="pro" id="plan_pro" form="signup_form"
                     aria-labelledby="plan-pro-name" aria-describedby="plan-pro-features"
                     class="relative z-10 w-5 h-5 shrink-0 cursor-pointer border-2 border-gray-300 dark:border-gray-500 dark:bg-gray-700 text-(--accent-600) focus:ring-(--accent-500)">
              <div>
                <h3 id="plan-pro-name" class="font-bold text-gray-900 dark:text-white text-lg">WetWijzer Pro</h3>
                <!-- Monthly price -->
                <div>
                  <p class="text-2xl font-bold text-(--accent-600)">€2,99
                    <span class="text-sm font-normal text-gray-500 dark:text-gray-400">/<%= case I18n.locale when :fr then 'mois' when :de then 'Monat' when :en then 'month' else 'maand' end %></span>
                  </p>
                </div>
              </div>
            </div>
          </div>
          <ul id="plan-pro-features" class="text-sm text-gray-600 dark:text-gray-400 space-y-2 ml-8">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span><strong><%= case I18n.locale when :fr then "#{Subscription::PRO_MONTHLY_CREDITS} crédits gratuits/mois" when :de then "#{Subscription::PRO_MONTHLY_CREDITS} gratis Credits/Monat" when :en then "#{Subscription::PRO_MONTHLY_CREDITS} free credits/month" else "#{Subscription::PRO_MONTHLY_CREDITS} gratis credits/maand" end %></strong> <%= case I18n.locale when :fr then 'inclus' when :de then 'inklusive' when :en then 'included' else 'inbegrepen' end %></span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span><strong><%= case I18n.locale when :fr then 'Tous les niveaux AI' when :de then 'Alle AI-Stufen' when :en then 'All AI levels' else 'Alle AI-niveaus' end %></strong> - <%= case I18n.locale when :fr then 'Malin → Omniscient' when :de then 'Schlau → Allwissend' when :en then 'Smart → Omniscient' else 'Slim → Alwetend' end %></span>
            </li>

            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span><strong><%= case I18n.locale when :fr then '30% réduction' when :de then '30% Rabatt' when :en then '30% discount' else '30% korting' end %></strong> - <%= case I18n.locale when :fr then 'sur les packs supplémentaires' when :de then 'auf zusätzliche Credit-Pakete' when :en then 'on extra credit packs' else 'op extra creditpakketten' end %></span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-red-400 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
              <span><%= case I18n.locale when :fr then 'Soutenez un projet indépendant' when :de then 'Unterstützen Sie ein unabhängiges Projekt' when :en then 'Support an independent project' else 'Steun een onafhankelijk project' end %></span>
            </li>
          </ul>
          <!-- AI Availability Disclaimer -->
          <div class="mt-3 p-2 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg">
            <p class="text-[10px] text-amber-700 dark:text-amber-300 leading-relaxed">
              ⚠ <%= case I18n.locale
                  when :fr then 'Les fonctionnalités AI dépendent de fournisseurs tiers. Disponibilité et prix peuvent changer sans préavis (§8.1b).'
                  when :de then 'AI-Funktionen hängen von Drittanbietern ab. Verfügbarkeit und Preise können sich ohne Vorankündigung ändern (§8.1b).'
                  when :en then 'AI features depend on third-party providers. Availability and pricing may change without notice (§8.1b).'
                  else 'AI-functies zijn afhankelijk van externe providers. Beschikbaarheid en prijzen kunnen zonder kennisgeving wijzigen (§8.1b).'
                  end %>
            </p>
          </div>
          <div id="plan-pro-confirmation"
               class="grid grid-rows-[0fr] invisible opacity-0 transition-[grid-template-rows,opacity,visibility] duration-300 motion-reduce:transition-none group-has-[:checked]:grid-rows-[1fr] group-has-[:checked]:visible group-has-[:checked]:opacity-100">
            <div class="min-h-0 overflow-hidden">
            <div class="mt-4 w-full py-2.5 px-4 rounded-lg text-sm font-semibold text-center
                        bg-(--accent-600-solid) text-white shadow-md">
              ✓ <%= case I18n.locale
                    when :fr then 'Pro sélectionné'
                    when :de then 'Pro ausgewählt'
                    when :en then 'Pro selected'
                    else 'Pro geselecteerd'
                    end %>
            </div>
            <p class="mt-1.5 text-[10px] text-center font-medium" style="color: var(--accent-600);">
              <%= case I18n.locale
                    when :fr then 'Vous serez redirigé vers le paiement après inscription'
                    when :de then 'Sie werden nach der Registrierung zur Zahlung weitergeleitet'
                    when :en then 'You\'ll be redirected to payment after registration'
                    else 'U wordt na registratie doorgestuurd naar betaling'
                    end %>
            </p>
            </div>
          </div>
        </div>

        </fieldset>

        <%# ── CREDIT PACKS HINT ── %>
        <div class="text-center text-xs text-gray-500 dark:text-gray-400 py-2">
          <svg class="w-4 h-4 inline-block mr-1 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <%= case I18n.locale
              when :fr then 'Vous pouvez aussi acheter des packs de crédits ponctuels.'
              when :de then 'Sie können auch einmalige Creditpakete kaufen.'
              when :en then 'You can also buy one-time credit packs.'
              else 'U kunt ook eenmalige creditpakketten kopen.'
              end %>
          <a href="<%= defined?(pricing_path) ? pricing_path : '/pricing' %>" class="underline text-(--accent-600) hover:text-(--accent-500) font-medium">
            <%= case I18n.locale when :fr then 'Voir les prix' when :de then 'Preise ansehen' when :en then 'View pricing' else 'Bekijk prijzen' end %> →
          </a>
        </div>
      </div>

      <%# ── RIGHT: Registration form ── %>
      <div class="order-1 lg:order-2">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 sm:p-8 border border-gray-200 dark:border-gray-700">

          <% if @user.errors.any? %>
            <div class="mb-4 bg-red-50 dark:bg-red-900/50 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300 px-4 py-3 rounded-lg">
              <ul class="list-disc list-inside text-sm">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= sanitize message, tags: %w[a span strong], attributes: %w[href class] %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= form_with model: @user, url: signup_path, method: :post, class: "space-y-5", id: "signup_form",
                data: { controller: "signup-challenge",
                        action: "submit->signup-challenge#submit turbo:submit-end->signup-challenge#reset",
                        signup_challenge_ready_value: t("auth.signup_challenge.ready"),
                        signup_challenge_verifying_value: t("auth.signup_challenge.verifying"),
                        signup_challenge_failed_value: t("auth.signup_challenge.failed"),
                        signup_challenge_expired_value: t("auth.signup_challenge.expired"),
                        signup_challenge_wait_value: t("auth.signup_challenge.wait") } do |f| %>
            <!-- Honeypot field: hidden from real users, bots will fill it -->
            <div style="position: absolute; left: -9999px;" aria-hidden="true">
              <label for="website">Leave this empty</label>
              <input type="text" name="website" id="website" tabindex="-1" autocomplete="off" />
            </div>

            <%# The plan comes from the radio inputs beside the form (form="signup_form"). %>
            <input type="hidden" name="interval" id="interval_field" value="monthly" />

            <div>
              <label for="user_name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                <%= t('auth.name') %> <span class="text-gray-500 dark:text-gray-400">(<%= t('auth.optional') %>)</span>
              </label>
              <%= f.text_field :name, 
                  class: "appearance-none relative block w-full px-3 py-3 border border-gray-300 dark:border-gray-600 placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white bg-white dark:bg-gray-800 rounded-md focus:outline-hidden focus:ring-(--accent-500) focus:border-(--accent-500) sm:text-sm",
                  placeholder: t('auth.name') %>
            </div>
            
            <div>
              <label for="user_email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                <%= t('auth.email') %> <span class="text-red-500">*</span>
              </label>
              <%= f.email_field :email, 
                  required: true,
                  autocomplete: "email",
                  class: "appearance-none relative block w-full px-3 py-3 border border-gray-300 dark:border-gray-600 placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white bg-white dark:bg-gray-800 rounded-md focus:outline-hidden focus:ring-(--accent-500) focus:border-(--accent-500) sm:text-sm",
                  placeholder: t('auth.email') %>
            </div>

            <div data-controller="password-strength password-visibility"
                 data-password-strength-labels-value="<%= t('auth.password_strength.labels').to_json %>"
                 data-password-strength-requirements-value="<%= t('auth.password_strength.requirements').to_json %>"
                 data-password-strength-empty-value="<%= t('auth.password_strength.empty') %>">
              <label for="user_password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                <%= t('auth.password') %> <span class="text-red-500">*</span>
              </label>
              <div class="relative">
                <%= f.password_field :password, 
                    required: true,
                    autocomplete: "new-password",
                    minlength: 8,
                    data: { password_strength_target: "input", password_visibility_target: "input", action: "input->password-strength#check" },
                    class: "appearance-none relative block w-full px-3 py-3 pr-10 border border-gray-300 dark:border-gray-600 placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white bg-white dark:bg-gray-800 rounded-md focus:outline-hidden focus:ring-(--accent-500) focus:border-(--accent-500) sm:text-sm",
                    placeholder: t('auth.password') %>
                <%= render 'shared/password_toggle' %>
              </div>
              <div class="mt-2">
                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                  <div data-password-strength-target="meter" role="progressbar" aria-label="<%= t('auth.password_strength.label') %>" aria-valuemin="0" aria-valuemax="4" aria-valuenow="0" aria-valuetext="<%= t('auth.password_strength.empty') %>" class="h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <div data-password-strength-target="text" role="status" aria-live="polite" aria-atomic="true" class="text-xs mt-1"></div>
                <div data-password-strength-target="requirements" class="mt-2 flex flex-wrap"><% t('auth.password_strength.requirements').each_value do |requirement| %><span class="text-gray-400 text-xs mr-3"><%= requirement %></span><% end %></div>
              </div>
            </div>

            <div data-controller="password-visibility">
              <label for="user_password_confirmation" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                <%= t('auth.password_confirmation') %> <span class="text-red-500">*</span>
              </label>
              <div class="relative">
                <%= f.password_field :password_confirmation, 
                    required: true,
                    autocomplete: "new-password",
                    data: { password_visibility_target: "input" },
                    class: "appearance-none relative block w-full px-3 py-3 pr-10 border border-gray-300 dark:border-gray-600 placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white bg-white dark:bg-gray-800 rounded-md focus:outline-hidden focus:ring-(--accent-500) focus:border-(--accent-500) sm:text-sm",
                    placeholder: t('auth.password_confirmation') %>
                <%= render 'shared/password_toggle' %>
              </div>
            </div>

            <div class="flex items-start">
              <%= f.check_box :terms_accepted, 
                  required: true,
                  class: "h-4 w-4 mt-1 text-(--accent-600) border-gray-300 rounded focus:ring-(--accent-500)" %>
              <label for="user_terms_accepted" class="ml-2 text-sm text-gray-600 dark:text-gray-400">
                <%= t('auth.terms_html', 
                    privacy_link: link_to(t('auth.privacy_policy'), privacy_policy_path, class: 'text-(--accent-600) hover:underline'),
                    terms_link: link_to(t('auth.terms_of_service'), terms_of_service_path, class: 'text-(--accent-600) hover:underline')
                ).html_safe %>
                <span class="text-red-500">*</span>
              </label>
            </div>

            <%= render "registrations/signup_challenge", challenge: @signup_challenge if @signup_challenge %>

            <button type="submit" data-signup-challenge-target="submit"
                    class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-(--accent-600-solid) hover:bg-(--accent-700-solid) focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-(--accent-500) transition">
              <%= t('auth.signup') %>
            </button>

            <p class="text-xs text-center text-gray-500">
              📬 <%= case I18n.locale
                  when :fr then "Après l'inscription, vérifiez votre dossier spam pour l'e-mail de confirmation."
                  when :de then 'Nach der Registrierung prüfen Sie bitte auch Ihren Spam-Ordner.'
                  when :en then 'After registration, check your spam folder for the confirmation email.'
                  else 'Na registratie: controleer ook uw spammap voor de bevestigingsmail.'
                  end %>
            </p>
          <% end %>

          <div class="mt-4 text-center">
            <%= link_to root_path, class: "text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white" do %>
              ← <%= case I18n.locale when :fr then 'Retour à' when :de then 'Zurück zu' when :en then 'Back to' else 'Terug naar' end %> <%= t('app_title') %>
            <% end %>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

