<% @title = "#{@case[:court]} - #{@case[:case_number]}" %>
<%# Both built from the stored cases.url where it exists, so the language
    segment JuPortal published under is the one we link to. %>
<%# With ?language_id= the controller lays a case_documents row over @case and
    keeps the stored row in @primary_case. JuPortal's two links stay the stored
    row's, because JuPortal filed the decision under that row's url; the
    Council's PDF follows the document shown, and falls back to the stored
    row's when the document recorded no address. raadvst_source_url validates
    and rebuilds, so a case_documents.url is never echoed either. %>
<% juportal_url = juportal_content_url(@primary_case) %>
<% juportal_pdf = juportal_pdf_link(@primary_case) %>
<%# A Council judgment or order that keeps JuPortal's url has no Council address
    of its own; raadvst_key_url derives one from the key, in the language of
    the text shown. JuPortal's two links stay beside it. %>
<% raadvst_url = raadvst_source_url(@case) || raadvst_source_url(@primary_case) || raadvst_key_url(@case) %>
<%# Carried by the three exports, so a download is the text on screen. %>
<% export_params = @showing_alternate ? { language_id: @page_language_id } : {} %>
<% appeal_info = court_appeal_info(@case[:court]) %>

<%# Chatbot context: enables the floating widget to offer case analysis %>
<meta name="chatbot-context"
      data-context-type="jurisprudence"
      data-case-court="<%= @case[:court] %>"
      data-case-number="<%= @case[:case_number] %>"
      data-case-date="<%= @case[:decision_date] %>"
      data-case-subject="<%= @case[:subject_matter] %>">

<style nonce="<%= content_security_policy_nonce %>">
  /* Tighten short intro lines (party names, addresses) - full paragraphs keep normal spacing */
  #full-text-content p.mb-3 { margin-bottom: 0.5rem; }
  #full-text-content h3, #full-text-content h4 { margin-top: 1.75rem; }
  /* Restore normal paragraph spacing after first heading appears */
  #full-text-content h3 ~ p.mb-3,
  #full-text-content h4 ~ p.mb-3 { margin-bottom: 0.75rem; }
</style>

<!-- Page Header -->
<div class="mb-6">
  <div class="bg-linear-to-r from-(--accent-500)/5 to-(--accent-500)/10 dark:from-(--accent-500)/10 dark:to-(--accent-500)/20 rounded-xl p-4 md:p-6 border border-(--accent-500)/20 dark:border-(--accent-500)/30">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between md:gap-4">
      <%# A long ECLI has no break opportunity: without min-w-0 and
          overflow-wrap the title kept its full width and pushed the copy
          button out of the box on a phone (WW-UI-04). %>
      <div class="flex items-center gap-3 min-w-0">
        <h1 class="min-w-0 [overflow-wrap:anywhere] text-xl md:text-2xl font-bold text-gray-900 dark:text-(--accent-500)">
          <%= @case[:case_number] %>
        </h1>
        <%# Copy ECLI button %>
        <button type="button"
                data-copy-text="<%= @case[:case_number] %>"
                class="source-detail-action shrink-0 inline-flex items-center gap-1.5 px-2 py-1.5 text-xs md:text-sm font-medium rounded-lg text-(--accent-700) dark:text-(--accent-400) hover:bg-(--accent-500)/10 border border-(--accent-500)/20 transition-colors duration-150"
                title="<%= case I18n.locale when :fr then 'Copier ECLI' when :de then 'ECLI kopieren' when :en then 'Copy ECLI' else 'Kopieer ECLI' end %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
        </button>
      </div>
      <div class="source-detail-toolbar flex flex-wrap items-center gap-2 no-print">
        <%# Language toggle: one pill per other language this decision can be
            read in. A second-language document opens on this same page
            (?language_id=), an advisory opinion's counterpart is the row under
            its sibling key; the controller decides which, the markup is the
            same. With nothing to offer, the greyed pill names the language
            that is missing. %>
        <% other_versions = Array(@language_versions).reject { |version| version[:current] } %>
        <% other_versions.each do |version| %>
          <% version_label = jurisprudence_language_label(version[:language_id]) %>
          <a href="<%= version[:href] %>"
             class="source-detail-action inline-flex items-center gap-1.5 px-2 py-1.5 md:px-3 text-xs md:text-sm font-medium rounded-lg text-(--accent-700) dark:text-(--accent-400) hover:bg-(--accent-500)/10 border border-(--accent-500)/20 transition-colors duration-150"
             title="<%= case I18n.locale when :fr then "Voir la version #{version_label}" when :de then "#{version_label}-Version anzeigen" when :en then "View #{version_label} version" else "Bekijk #{version_label} versie" end %>">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
            </svg>
            <span class="source-detail-label hidden sm:inline"><%= version_label %></span>
          </a>
        <% end %>
        <% if other_versions.empty? %>
          <% missing_label = jurisprudence_language_label(@page_language_id == 1 ? 2 : 1) %>
          <button type="button"
                  data-toast-message="<%= case I18n.locale when :fr then 'Version non disponible' when :de then 'Version nicht verfügbar' when :en then 'Version not available' else 'Versie niet beschikbaar' end %>"
                  class="source-detail-action inline-flex items-center gap-1.5 px-2 py-1.5 md:px-3 text-xs md:text-sm font-medium rounded-lg text-gray-400 dark:text-gray-500 border border-gray-200 dark:border-gray-700 cursor-default opacity-60"
                  title="<%= case I18n.locale when :fr then "Pas de version #{missing_label} disponible" when :de then "Keine #{missing_label}-Version verfügbar" when :en then "No #{missing_label} version available" else "Geen #{missing_label} versie beschikbaar" end %>">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
            </svg>
            <span class="source-detail-label hidden sm:inline"><%= missing_label %></span>
          </button>
        <% end %>
        <%# Export Word button %>
        <a href="<%= export_word_jurisprudence_path(@case[:case_number], export_params) %>"
           class="source-detail-action inline-flex items-center gap-1.5 px-2 py-1.5 md:px-3 text-xs md:text-sm font-medium rounded-lg text-(--accent-700) dark:text-(--accent-400) hover:bg-(--accent-500)/10 border border-(--accent-500)/20 transition-colors duration-150"
           title="<%= case I18n.locale when :fr then 'Télécharger en Word' when :de then 'Als Word-Dokument herunterladen' when :en then 'Download as Word document' else 'Download als Word-document' end %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span class="source-detail-label hidden sm:inline">Word</span>
        </a>
        <%# Export Typst button %>
        <a href="<%= export_typst_jurisprudence_path(@case[:case_number], export_params) %>"
           class="source-detail-action inline-flex items-center gap-1.5 px-2 py-1.5 md:px-3 text-xs md:text-sm font-medium rounded-lg text-(--accent-700) dark:text-(--accent-400) hover:bg-(--accent-500)/10 border border-(--accent-500)/20 transition-colors duration-150"
           title="<%= case I18n.locale when :fr then 'Télécharger en Typst' when :de then 'Als Typst-Dokument herunterladen' when :en then 'Download as Typst document' else 'Download als Typst-document' end %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span class="source-detail-label hidden sm:inline">Typst</span>
        </a>
        <%# Export ODT button %>
        <a href="<%= export_odt_jurisprudence_path(@case[:case_number], export_params) %>"
           class="source-detail-action inline-flex items-center gap-1.5 px-2 py-1.5 md:px-3 text-xs md:text-sm font-medium rounded-lg text-(--accent-700) dark:text-(--accent-400) hover:bg-(--accent-500)/10 border border-(--accent-500)/20 transition-colors duration-150"
           title="<%= case I18n.locale when :fr then 'Télécharger en ODT' when :de then 'Als ODT-Dokument herunterladen' when :en then 'Download as ODT document' else 'Download als ODT-document' end %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span class="source-detail-label hidden sm:inline">ODT</span>
        </a>
        <%# Print button %>
        <button type="button"
                data-controller="print" data-action="click->print#fire"
                class="source-detail-action inline-flex items-center gap-1.5 px-2 py-1.5 md:px-3 text-xs md:text-sm font-medium rounded-lg text-(--accent-700) dark:text-(--accent-400) hover:bg-(--accent-500)/10 border border-(--accent-500)/20 transition-colors duration-150"
                title="<%= case I18n.locale when :fr then 'Imprimer' when :de then 'Drucken' when :en then 'Print' else 'Afdrukken' end %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5 4v3H4a2 2 0 00-2 2v3a2 2 0 002 2h1v2a2 2 0 002 2h6a2 2 0 002-2v-2h1a2 2 0 002-2V9a2 2 0 00-2-2h-1V4a2 2 0 00-2-2H7a2 2 0 00-2 2zm8 0H7v3h6V4zm0 8H7v4h6v-4z" clip-rule="evenodd"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Main Content Area -->
<div class="w-full space-y-6">
  <%# External links: the source and the original PDF, in the same card the
      legislation pages use, rather than as toolbar buttons. %>
  <% if juportal_url || juportal_pdf.present? || raadvst_url %>
    <div id="external-links-card" class="no-print bg-white dark:bg-gray-800 rounded-xl shadow-sm scroll-mt-24">
      <%= render 'jurisprudence/external_links', juportal_url: juportal_url, juportal_pdf: juportal_pdf, raadvst_url: raadvst_url %>
    </div>
  <% end %>
  <!-- Case Metadata -->
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg scroll-mt-24">
    <div class="p-4 md:p-6">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-(--accent-500) mb-3">
        <% case I18n.locale when :fr %>Détails de la décision<% when :de %>Entscheidungsdetails<% when :en %>Decision details<% else %>Beslissingsdetails<% end %>
      </h2>
      <div class="flex flex-wrap gap-2 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-(--accent-100) dark:bg-(--accent-900)/30 text-(--accent-700) dark:text-(--accent-400)">
          🏛️ <%= @case[:court] %>
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-300">
          📅 <%= @case[:decision_date] %>
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-300">
          🌐 <%= jurisprudence_language_label(@page_language_id) %>
        </span>
        <%# The language the decision was given in, which the badge above cannot
            say: that one names the text on screen. Shown only where the loader
            established it (NULL is "unknown", not "the same"); how it was
            established rides in the title. The second pill appears only when
            the text on screen is in another language than that, and never on a
            document whose role the loader recorded as 'parallel' or 'original'.
            Of the 2,373 judgments served in two languages, 1,683 are an original
            and its translation (exactly one side carries the preface) and 662
            come from the bilingual Vth chamber or the general assembly, where
            both versions are official: those are the 'parallel' ones, and
            neither is a translation of the other. The stored row has no role of
            its own, so beside a 'parallel' document it is taken for parallel
            too.
            A document the loader recorded as 'translation' says so without the
            official language: a single served version that carries a
            translation preface (114 numbers) is written with that role and gets
            no language fact, because the preface does not print which language
            it was translated from.
            The rule itself, and why a German official language infers nothing
            about the stored row, is jurisprudence_translation?. %>
        <% official_label = jurisprudence_language_label(@case[:original_language_id]) %>
        <% shown_role = @showing_alternate ? @case[:document_role] : (Array(@language_versions).any? { |version| version[:role] == 'parallel' } ? 'parallel' : nil) %>
        <% if official_label %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-300"
                title="<%= @case[:original_language_source] %>">
            <%= case I18n.locale when :fr then 'Langue officielle :' when :de then 'Amtssprache:' when :en then 'Official language:' else 'Officiële taal:' end %> <%= official_label %>
          </span>
        <% end %>
        <% if jurisprudence_translation?(@case[:original_language_id], @page_language_id, shown_role) %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-300">
            <%= case I18n.locale when :fr then 'Traduction' when :de then 'Übersetzung' when :en then 'Translation' else 'Vertaling' end %>
          </span>
        <% end %>
        <% if @case[:decision_type].present? %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-300">
            <%= @case[:decision_type].capitalize %>
          </span>
        <% end %>
        <% if @case[:outcome].present? %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-300">
            <%= @case[:outcome] %>
          </span>
        <% end %>
      </div>

      <%# Who decided the case. Recorded as data by the scraper, because reading
          it out of the text is what a reader should not have to do - and because
          which judge decided what is a question the corpus should be able to
          answer. Office-holders are named: they sign in an official capacity and
          the source publishes them. %>
      <% if @case[:bench].present? %>
        <div class="mb-3">
          <h3 class="text-sm font-medium text-gray-500 dark:text-gray-300/70 mb-1">
            <% case I18n.locale when :fr %>Composition<% when :de %>Besetzung<% when :en %>Bench<% else %>Zetel<% end %>
          </h3>
          <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-700 dark:text-gray-300">
            <% @case[:bench].each do |member| %>
              <li>
                <span class="font-medium"><%= member[:name] %></span><% if member[:office].present? %><span class="text-gray-500 dark:text-gray-400">, <%= member[:office] %></span><% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if @case[:subject_matter].present? %>
        <div class="mb-3">
          <h3 class="text-sm font-medium text-gray-500 dark:text-gray-300/70 mb-1">
            <% case I18n.locale when :fr %>Matière<% when :de %>Rechtsgebiet<% when :en %>Subject matter<% else %>Rechtsgebied<% end %>
          </h3>
          <div class="flex flex-wrap gap-1">
            <% @case[:subject_matter].split(',').map(&:strip).each do |subject| %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-(--accent-100) dark:bg-(--accent-900)/30 text-(--accent-700) dark:text-(--accent-400)">
                <%= subject %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @referenced_laws.present? %>
        <div>
          <h3 class="text-sm font-medium text-gray-500 dark:text-gray-300/70 mb-1">
            <% case I18n.locale when :fr %>Législation citée<% when :de %>Zitierte Gesetzgebung<% when :en %>Cited legislation<% else %>Geciteerde wetgeving<% end %>
          </h3>
          <div class="flex flex-wrap gap-1.5">
            <% @referenced_laws.each do |ref| %>
              <a href="<%= law_path(ref[:numac]) %>"
                 class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium
                        bg-(--accent-100) dark:bg-(--accent-900)/30
                        text-(--accent-700) dark:text-(--accent-400)
                        hover:bg-(--accent-200) dark:hover:bg-(--accent-800)/40
                        transition-colors duration-150"
                 title="<%= ref[:numac] %>">
                <svg class="w-3 h-3 mr-1 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <%= ref[:title] || ref[:numac] %>
              </a>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# The parliamentary documents that print or cite this advisory opinion
          (opinion_parliament_links.sqlite3, written weekly by
          lib/tasks/opinion_parliament_links.py): one entry per document, in
          the page's language where the Chamber printed both. Only an RVSADV
          page ever has any; a judgment gets nothing. %>
      <% if @parliamentary_documents.present? %>
        <div id="parliamentary-documents" class="<%= 'mt-3' if @referenced_laws.present? %>">
          <h3 class="text-sm font-medium text-gray-500 dark:text-gray-300/70 mb-1">
            <% case I18n.locale when :fr %>Documents parlementaires<% when :de %>Parlamentsdokumente<% when :en %>Parliamentary documents<% else %>Parlementaire stukken<% end %>
          </h3>
          <ul class="flex flex-wrap gap-1.5">
            <% @parliamentary_documents.each do |doc| %>
              <li>
                <a href="<%= parliamentary_path(doc[:id]) %>"
                   class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium
                          bg-(--accent-100) dark:bg-(--accent-900)/30
                          text-(--accent-700) dark:text-(--accent-400)
                          hover:bg-(--accent-200) dark:hover:bg-(--accent-800)/40
                          transition-colors duration-150"
                   title="<%= doc[:document_date] %>">
                  <svg class="w-3 h-3 mr-1 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                  <%= parliamentary_document_label(doc) %>
                </a>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

    </div>
  </div>

  <!-- Summary -->
  <% if @case[:summary].present? %>
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg scroll-mt-24">
      <div class="p-4 md:p-6">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-(--accent-500) mb-3">
          <% case I18n.locale when :fr %>Résumé<% when :de %>Zusammenfassung<% when :en %>Summary<% else %>Samenvatting<% end %>
        </h2>
        <div class="p-4 bg-(--accent-500)/5 dark:bg-gray-900 rounded-lg text-gray-700 dark:text-gray-300 border-l-4 border-(--accent-400) text-justify">
          <%= clean_jurisprudence_summary(@case[:summary]) %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Full Text -->
  <%# full_text is the only maintained column: it is what the scraper
      pseudonymizes, what cases_fts indexes and what every repair pass
      writes. rich_text was a plain-text copy frozen in April 2026 and was
      never pseudonymized, so preferring it served pre-redaction names on
      7,392 rows and hid every repair since. %>
  <% display_text = @case[:full_text] %>
  <% if display_text.present? %>
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg scroll-mt-24">
      <div class="p-4 md:p-6">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-(--accent-500) mb-4">
          <% case I18n.locale when :fr %>Texte intégral<% when :de %>Volltext<% when :en %>Full text<% else %>Volledige tekst<% end %>
        </h2>
        <div id="full-text-content" class="max-w-none">
          <div class="text-base text-gray-700 dark:text-gray-300 leading-relaxed" style="text-align: justify;">
<%= clean_jurisprudence_full_text(display_text, case_number: @case[:case_number]) %>
          </div>
        </div>

        <%# Extracted PDF images. Historically these rendered inline via
            [[IMG:...]] markers in rich_text; those markers were lost in an
            old DB rebuild (table restored from disk 2026-07-14), so when the
            text carries no markers we show the images as a gallery instead
            of silently dropping them. %>
        <% if @case_images.present? && !display_text.include?('[[IMG:') %>
          <div class="mt-6 border-t border-gray-200 dark:border-gray-700 pt-4">
            <h3 class="text-base font-semibold text-gray-900 dark:text-(--accent-500) mb-3">
              <% case I18n.locale when :fr %>Illustrations du document<% when :de %>Abbildungen<% when :en %>Document images<% else %>Afbeeldingen uit het document<% end %>
              <span class="text-sm font-normal text-gray-500">(<%= @case_images.size %>)</span>
            </h3>
            <div class="flex flex-wrap gap-4">
              <% @case_images.each do |img| %>
                <figure class="text-center">
                  <img src="<%= jurisprudence_image_path(@case[:case_number], img[:filename]) %>"
                       alt="" loading="lazy"
                       class="inline-block h-auto rounded-lg border border-gray-200 dark:border-gray-700"
                       style="max-width: min(100%, <%= [img[:width].to_i, 480].min %>px); max-height: 400px;">
                  <figcaption class="text-xs text-gray-400 mt-1">p.<%= img[:page] %></figcaption>
                </figure>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Ask chatbot -->
  <div class="p-4 bg-linear-to-r from-(--accent-50) to-(--accent-100)/30 dark:from-(--accent-900)/20 dark:to-midnight rounded-xl border border-(--accent-200) dark:border-(--accent-800)/30">
    <div class="flex items-center gap-4">
      <div class="shrink-0">
        <svg class="w-8 h-8 text-(--accent-600) dark:text-(--accent-400)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
        </svg>
      </div>
      <div class="flex-1">
        <h3 class="font-medium text-gray-900 dark:text-(--accent-500)">
          <% if advisory_opinion?(@case) %>
            <% case I18n.locale when :fr %>Questions sur cet avis ?<% when :de %>Fragen zu diesem Gutachten?<% when :en %>Questions about this opinion?<% else %>Vragen over dit advies?<% end %>
          <% else %>
            <% case I18n.locale when :fr %>Questions sur cet arrêt?<% when :de %>Fragen zu diesem Urteil?<% when :en %>Questions about this ruling?<% else %>Vragen over dit arrest?<% end %>
          <% end %>
        </h3>
        <p class="text-sm text-gray-600 dark:text-gray-300/80">
          <% case I18n.locale when :fr %>Posez vos questions à notre assistant IA juridique<% when :de %>Stellen Sie Ihre Fragen an unseren juristischen KI-Assistenten<% when :en %>Ask our legal AI assistant<% else %>Stel uw vragen aan onze juridische AI-assistent<% end %>
        </p>
      </div>
      <a href="<%= chatbot_path(source: 'jurisprudence') %>"
         class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-lg text-(--accent-700) dark:text-(--accent-400) hover:bg-(--accent-500)/10 border border-(--accent-500)/20 transition-colors duration-150">
        <%= t('chatbot.open_chatbot') %>
      </a>
    </div>
  </div>

  <!-- GDPR: Pseudonymization notice + takedown link -->
  <div class="p-4 bg-amber-50/50 dark:bg-amber-900/10 rounded-xl border border-amber-200/50 dark:border-amber-800/30">
    <div class="flex items-start gap-3">
      <div class="shrink-0 mt-0.5">
        <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
        </svg>
      </div>
      <div class="flex-1">
        <p class="text-sm text-amber-800 dark:text-amber-200">
          <% case I18n.locale
             when :fr %>
            Ce texte est <strong>automatiquement pseudonymisé</strong>. Malgré un traitement minutieux, certaines données personnelles peuvent ne pas être entièrement masquées.
          <% when :de %>
            Dieser Text wurde <strong>automatisch pseudonymisiert</strong>. Trotz sorgfältiger Verarbeitung kann es vorkommen, dass personenbezogene Daten nicht vollständig maskiert sind.
          <% when :en %>
            This text has been <strong>automatically pseudonymised</strong>. Despite careful processing, some personal data may not be fully masked.
          <% else %>
            Deze tekst is <strong>automatisch gepseudonimiseerd</strong>. Ondanks zorgvuldige verwerking kan het voorkomen dat persoonsgegevens niet volledig zijn gemaskeerd.
          <% end %>
        </p>
        <a href="<%= gdpr_takedown_path(ecli: @case[:case_number]) %>"
           class="inline-flex items-center gap-1.5 mt-2 px-3 py-1.5 text-xs font-medium rounded-lg text-amber-700 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-900/30 border border-amber-300/50 dark:border-amber-700/50 transition-colors duration-150">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <%= case I18n.locale when :fr then 'Signaler des données personnelles' when :de then 'Personenbezogene Daten melden' when :en then 'Report personal data' else 'Persoonsgegevens melden' end %>
        </a>
      </div>
    </div>
  </div>
</div>

<%# Schema.org Structured Data (JSON-LD) %>
<% content_for :head do %>
<script type="application/ld+json">
<%= raw({
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "additionalType": "https://schema.org/Legislation",
  "name": @case[:case_number],
  "description": "#{@case[:court]} - #{@case[:decision_type].try(:capitalize)} #{@case[:decision_date]}",
  "datePublished": @case[:decision_date].to_s,
  "inLanguage": jurisprudence_language_code(@page_language_id),
  "author": {
    "@type": "Organization",
    "name": @case[:court]
  },
  "publisher": {
    "@type": "Organization",
    "name": "WetWijzer",
    "url": "https://wetwijzer.be"
  },
  "url": request.original_url,
  "identifier": @case[:case_number],
  "about": @case[:subject_matter].present? ? @case[:subject_matter].split(',').map(&:strip) : nil,
  "isPartOf": {
    "@type": "WebSite",
    "name": "WetWijzer",
    "url": "https://wetwijzer.be"
  }
}.compact.to_json) %>
</script>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  document.querySelectorAll('[data-copy-text]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      navigator.clipboard.writeText(this.dataset.copyText);
      var svg = this.querySelector('svg');
      if (svg) { svg.classList.add('text-green-500'); setTimeout(function() { svg.classList.remove('text-green-500'); }, 1500); }
    });
  });
  document.querySelectorAll('[data-toast-message]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var t = document.createElement('div');
      t.textContent = this.dataset.toastMessage;
      t.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 px-4 py-2 bg-gray-800 dark:bg-gray-200 text-white dark:text-gray-800 text-sm rounded-lg shadow-xl z-50 transition-opacity';
      document.body.appendChild(t);
      setTimeout(function() { t.style.opacity = '0'; setTimeout(function() { t.remove(); }, 300); }, 2500);
    });
  });
</script>

