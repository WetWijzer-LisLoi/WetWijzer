<% if defined?(@laws) && params[:title].present? && @laws&.empty? &&
      !@validation_failed && !@search_incomplete &&
      @jurisprudence_results.blank? && @jurisprudence_total_count.to_i.zero? &&
      @parliamentary_results.blank? && @parliamentary_total_count.to_i.zero? %>
  <div data-search-empty-hint class="text-xs text-gray-600 dark:text-gray-400 mt-2">
    <span class="text-amber-600 dark:text-amber-400 font-medium">
      <% if params[:exact_match] == '1' || params[:search_mode].to_s == 'exact' %>
        <%= t(:search_hints_no_results_with_exact) %>
      <% else %>
        <%= t(:search_hints_no_results_without_exact) %>
      <% end %>
    </span>
  </div>
<% end %>
