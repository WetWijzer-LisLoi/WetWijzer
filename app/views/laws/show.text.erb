<%# Plain-text law detail for curl users.
    Try: curl https://classic.wetwijzer.be/laws/1992041050.txt -%>
<%- if @law.present? -%>
<%= raw strip_tags(@law.title.to_s).squish %>

NUMAC: <%= @law.numac %>
<%= t(:date_label) %>: <%= @law.date %>
<%- if @law.respond_to?(:justel) && @law.justel.present? -%>
Justel: <%= @law.justel %>
<%- end -%>
<%- if (fisconet_note = fisconet_text_source_note(@law.numac)) -%>
<%= fisconet_note %>
<%- if (fisconet_numac = FisconetSearchService.fisconet_numac_for_justel(@law.numac)).present? -%>
<%= fisconet_history_pointer.join(' ') %>: <%= law_url(fisconet_numac) %>
<%- end -%>
<%- end -%>
<%- if @german_notice -%>

<%= raw @german_notice[:label] %>
<%= raw [
      "#{t('german_text.source')}: #{@german_notice[:source_name]}",
      (@german_notice[:source_url] && "<#{@german_notice[:source_url]}>"),
      (@german_notice[:fetched_on] && "(#{t('german_text.fetched_on', date: @german_notice[:fetched_on])})")
    ].compact.join(' ') %>
<%- elsif german_site? && @law.language_id == 2 && !Array(@language_versions).include?(HasLanguage::GERMAN_LANGUAGE_ID) -%>

<%= t('german_text.french_fallback') %>
<%- end -%>

<%- if @articles.present? -%>
<%- @articles.each do |article| -%>
<%- art_type = determine_article_type(article.article_title, article.article_text, article.article_type) -%>
<%- if art_type == :section_heading || art_type == :abolished_section -%>

== <%= raw strip_tags(article.article_text.to_s).squish %> ==

<%- else -%>
<%- if article.article_title.present? && article.article_title.strip != '#' -%>
<%= article.article_title.strip %>
<%- end -%>
<%= raw strip_tags(article.article_text.to_s).gsub(/\r\n?/, "\n").gsub(/\n{3,}/, "\n\n").strip %>

<%- end -%>
<%- end -%>
<%- elsif @content&.respond_to?(:introd) && @content.introd.present? -%>
<%= raw strip_tags(@content.introd.to_s).squish %>
<%- else -%>
<%= t(:no_articles_available, default: 'Geen artikelen beschikbaar.') %>
<%- end -%>
<%- else -%>
<%= t(:law_not_found) %>
<%- end -%>
