<%# One history snapshot for all sources; document links still leave the frame. %>
<%= turbo_frame_tag 'search_results', target: '_top', data: { turbo_action: 'advance', controller: 'results-landing' } do %>
<%# ── Search Results Container ── %>
<div class="mt-4 space-y-4">
  <!-- Mount target for the completed pill below the search bar -->
  <div id="search-status-mount" class="w-full"></div>
  <%= render 'laws/search_hints' %>

  <!-- Results Section: one landmark for the three sources (it closed after the legislation list until 1.1.31) -->
  <div aria-live="polite" aria-relevant="additions removals" role="region" aria-label="<%= t('search_results', default: 'Zoekresultaten') %>" class="space-y-4">
    <% if @validation_failed %>
      <div class="mb-4 rounded-md border border-red-300 bg-red-50 p-4 text-red-800 dark:border-red-600/40 dark:bg-red-900/30 dark:text-red-200">
        <p class="font-semibold"><%= t('filters.validation.incomplete') %></p>
        <p class="mt-1"><%= t('filters.validation.fix') %></p>
        <% if defined?(@missing_labels) && @missing_labels.present? %>
          <% anchor_map = { types: '#filter-types', languages: '#filter-languages', scope: '#filter-scope' } %>
          <ul class="mt-2 list-disc pl-6">
            <% @missing_keys.each_with_index do |key, idx| %>
              <% label = @missing_labels[idx] %>
              <li>
                <a href="<%= anchor_map[key] %>" class="underline decoration-red-400 hover:text-red-600 dark:hover:text-red-300"><%= label %></a>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>

    <% frame_src = if @validation_failed
         nil
       else
         laws_path(request.query_parameters.merge(frame: 1))
       end %>

    <%# ── Wetgeving Results ── %>
    <% if frame_src.present? && params[:source_legislation] != '0' %>
      <details open data-results-section="legislation" class="search-results-disclosure scroll-mt-24 bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden group">
        <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none border-b border-gray-100 dark:border-gray-700/50 hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
          <h2 class="text-sm sm:text-base font-bold text-gray-900 dark:text-white flex items-center gap-2 m-0">
            <svg class="w-4 h-4 text-(--accent-600) shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            <%= case I18n.locale when :fr then 'Législation' when :de then 'Gesetzgebung' when :en then 'Legislation' else 'Wetgeving' end %>
            <span id="wetgeving-count" class="font-normal text-gray-500 dark:text-gray-400"></span>
          </h2>
          <svg class="search-section-chevron w-4 h-4 shrink-0 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <% if request.headers['Turbo-Frame'] == 'search_results' %>
          <%= render template: 'laws/list', layout: false %>
        <% else %>
        <%= turbo_frame_tag 'laws_list', src: frame_src,
              data: { controller: 'frame-status', frame_status_loading_value: t('loading_status.loading'), frame_status_completed_value: t('loading_status.completed'), frame_status_duration_value: 4000, frame_status_mount_selector_value: '#search-status-mount' } do %>
          <div>
            <div class="progress-top text-(--accent-600) dark:text-blue-400"></div>
            <%= loading_skeleton_tag(kind: :list) %>
          </div>
        <% end %>
        <% end %>
      </details>
    <% else %>
      <%= turbo_frame_tag 'laws_list' %>
    <% end %>
  <%# ── Rechtspraak Results ── %>
  <% if @jurisprudence_results.present? %>
    <%
      juris_sort = params[:juris_sort].presence || 'date_desc'
      juris_sort_label = juris_sort == 'date_asc' ? (case I18n.locale when :fr then 'Date ↑' when :en then 'Date ↑' else 'Datum ↑' end) : (case I18n.locale when :fr then 'Date ↓' when :en then 'Date ↓' else 'Datum ↓' end)
    %>
    <details open data-results-section="jurisprudence" class="search-results-disclosure scroll-mt-24 bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden group">
      <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none border-b border-gray-100 dark:border-gray-700/50 hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
        <h2 class="text-sm sm:text-base font-bold text-gray-900 dark:text-white flex items-center gap-2 m-0">
          <svg class="w-4 h-4 text-(--accent-600) shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
          </svg>
          <%= case I18n.locale when :fr then 'Jurisprudence' when :de then 'Rechtsprechung' when :en then 'Case law' else 'Rechtspraak' end %>
          <span class="font-normal text-gray-500 dark:text-gray-400">(<%= number_with_delimiter(@jurisprudence_total_count) %>)</span>
        </h2>
        <svg class="search-section-chevron w-4 h-4 shrink-0 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <%# Results bar with sort %>
      <div class="search-results-tools flex items-center justify-between px-4 py-2 border-b border-gray-100 dark:border-gray-700/50">
        <span class="text-xs text-gray-500 dark:text-gray-400 font-medium">
          <%= t(:results_found, count: @jurisprudence_total_count) %>
        </span>
        <div class="relative inline-block text-left" data-controller="dropdown">
          <button type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-sky/10 focus:outline-hidden focus:ring-2 focus:ring-offset-1 focus:ring-(--accent-500)" data-action="click->dropdown#toggle" data-dropdown-target="button" aria-haspopup="true">
            <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h9m5-4v12m0 0l-4-4m4 4l4-4"/>
            </svg>
            <span><%= t(:sort_order) %>: <span class="font-semibold"><%= juris_sort_label %></span></span>
            <svg class="w-4 h-4 text-gray-400 transition-transform" data-dropdown-target="arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="hidden absolute right-0 z-20 mt-1 w-48 origin-top-right rounded-md bg-white dark:bg-gray-800 shadow-lg ring-1 ring-black/5 dark:ring-sky/30 focus:outline-hidden" data-dropdown-target="menu" role="menu">
            <div class="py-1" role="none">
              <% [['date_desc', (case I18n.locale when :fr then 'Date ↓ (récent)' when :de then 'Datum ↓ (neueste)' when :en then 'Date ↓ (newest)' else 'Datum ↓ (nieuwste)' end)], ['date_asc', (case I18n.locale when :fr then 'Date ↑ (ancien)' when :de then 'Datum ↑ (älteste)' when :en then 'Date ↑ (oldest)' else 'Datum ↑ (oudste)' end)]].each do |key, label| %>
                <% is_current = juris_sort == key %>
                <% sort_params = request.query_parameters.except('frame', 'juris_page').merge(juris_sort: key) %>
                <%= link_to laws_path(sort_params), class: "flex items-center px-4 py-2 text-sm #{is_current ? 'bg-(--accent-50) dark:bg-(--accent-500)/20 text-(--accent-700) dark:text-(--accent-400) font-medium' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-sky/10'}", role: "menuitem", data: { turbo_frame: 'search_results', turbo_action: 'advance' } do %>
                  <% if is_current %>
                    <svg class="w-4 h-4 mr-2 text-(--accent-600)" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  <% else %>
                    <span class="w-4 mr-2"></span>
                  <% end %>
                  <%= label %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      <div class="overflow-x-auto w-full">
        <table role="table" class="w-full results-table results-table--case" aria-label="<%= t('global_search.jurisprudence') %>">
          <thead role="rowgroup" class="bg-linear-to-r from-(--accent-500)/5 to-(--accent-500)/10 dark:from-(--accent-500)/20 dark:to-(--accent-500)/30">
            <tr role="row" class="border-b-2 border-(--accent-500)/20 dark:border-(--accent-500)/50">
              <th role="columnheader" scope="col" class="w-28 px-2 py-3 text-center text-xs leading-4 font-medium text-gray-700 dark:text-gray-300 tracking-wider whitespace-nowrap">
                <%= case I18n.locale when :fr then 'Date' when :de then 'Datum' when :en then 'Date' else 'Datum' end %>
              </th>
              <th role="columnheader" scope="col" class="px-4 py-3 text-left text-xs leading-4 font-medium text-gray-700 dark:text-gray-300 tracking-wider" style="width:40%">
                <%= case I18n.locale when :fr then 'Numéro / Cour' when :de then 'Nummer / Gericht' when :en then 'Number / Court' else 'Nummer / Rechtbank' end %>
              </th>
              <th role="columnheader" scope="col" class="w-full px-4 py-3 text-left text-xs leading-4 font-medium text-gray-700 dark:text-gray-300 tracking-wider">
                <%= case I18n.locale when :fr then 'Résumé' when :de then 'Zusammenfassung' when :en then 'Summary' else 'Samenvatting' end %>
              </th>
              <th role="columnheader" scope="col" class="w-10 px-1 py-3 text-center text-xs leading-4 font-medium text-gray-700 dark:text-gray-300 tracking-wider whitespace-nowrap no-print">
                <span class="sr-only"><%= t('bookmarks.title') %></span>
                <span class="inline-flex items-center justify-center w-6 h-6 mx-auto">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" title="<%= t('bookmarks.title') %>">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                  </svg>
                </span>
              </th>
            </tr>
          </thead>
          <tbody role="rowgroup" class="divide-y divide-gray-100 dark:divide-(--border-divider) dark:bg-gray-800">
            <% @jurisprudence_results.each_with_index do |result, idx| %>
              <tr role="row" class="<%= idx.odd? ? 'bg-white dark:bg-gray-800' : 'bg-gray-50 dark:bg-gray-900' %> hover:bg-(--accent-active-bg) transition-colors duration-200">
                <td role="cell" class="result-date w-28 px-2 py-3 align-top text-sm leading-5 font-medium text-gray-700 dark:text-gray-300 text-center whitespace-nowrap">
                  <span class="badge-date">
                    <% if result[:decision_date].present? %>
                      <% begin %>
                        <%= Date.parse(result[:decision_date]).strftime('%d/%m/%Y') %>
                      <% rescue %>
                        <%= result[:decision_date] %>
                      <% end %>
                    <% else %>
                      –
                    <% end %>
                  </span>
                </td>
                <td role="cell" class="result-content px-4 py-3 align-top text-sm leading-5" style="width:40%">
                  <a data-turbo-frame="_top" href="<%= jurisprudence_path(result[:case_number]) %>" class="font-medium text-(--accent-700) dark:text-(--accent-400) hover:underline">
                    <%= result[:case_number] %>
                  </a>
                  <% if result[:court].present? %>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><%= result[:court] %></p>
                  <% end %>
                </td>
                <td role="cell" class="result-content w-full px-4 py-3 align-top whitespace-normal text-sm leading-5 text-gray-600 dark:text-gray-300">
                  <% if result[:summary].present? %>
                    <p class="line-clamp-2"><%= truncate(result[:summary], length: 200) %></p>
                  <% else %>
                    <span class="text-gray-400 dark:text-gray-500 italic text-xs">–</span>
                  <% end %>
                </td>
                <td role="cell" class="result-action w-10 px-1 py-3 align-top text-center whitespace-nowrap no-print">
                  <button type="button"
                    class="bookmark-btn inline-flex items-center justify-center w-6 h-6 mx-auto text-gray-400 hover:text-(--accent-500) dark:text-gray-500 dark:hover:text-(--accent-400) transition-colors duration-200"
                    data-controller="bookmark"
                    data-bookmark-numac-value="juris:<%= result[:id] %>"
                    data-bookmark-title-value="<%= escape_once("#{result[:case_number]} – #{result[:court]}".truncate(200)) %>"
                    data-action="click->bookmark#toggle"
                    title="<%= t('bookmarks.add') %>">
                    <svg data-bookmark-target="icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                    </svg>
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @juris_pagy && @juris_pagy.last > 1 %>
        <div class="flex items-center justify-between px-4 sm:px-6 py-3 bg-white dark:bg-gray-800">
          <div class="flex-1">
            <%= render 'shared/pagy/nav', pagy: @juris_pagy, frame_target: 'search_results' %>
          </div>
        </div>
      <% end %>
    </details>
  <% elsif @jurisprudence_searched %>
    <%= render 'laws/source_empty_state', source: :jurisprudence, timed_out: @jurisprudence_timed_out %>
  <% end %>


  <%# ── Parlementaire Stukken Results ── %>
  <% if @parliamentary_results.present? %>
    <%
      # Generic page titles (the site's search page, its refusal page) come
      # from ParliamentaryHelper::GENERIC_PARL_TITLES, the one list.
      parliament_labels = {
        'kamer' => 'Kamer', 'chamber' => 'Kamer',
        'senaat' => 'Senaat', 'senate' => 'Senaat',
        'vlaams' => 'Vlaams Parlement', 'brussels' => 'Brussels Parlement',
        'waals' => 'Waals Parlement', 'walloon' => 'Waals Parlement'
      }
      parl_sort = params[:parl_sort].presence || 'date_desc'
      parl_sort_label = parl_sort == 'date_asc' ? (case I18n.locale when :fr then 'Date ↑' when :en then 'Date ↑' else 'Datum ↑' end) : (case I18n.locale when :fr then 'Date ↓' when :en then 'Date ↓' else 'Datum ↓' end)
    %>
    <details open data-results-section="parliamentary" class="search-results-disclosure scroll-mt-24 bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden group">
      <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none border-b border-gray-100 dark:border-gray-700/50 hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
        <h2 class="text-sm sm:text-base font-bold text-gray-900 dark:text-white flex items-center gap-2 m-0">
          <svg class="w-4 h-4 text-(--accent-600) shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
          <%= case I18n.locale when :fr then 'Travaux parlementaires' when :de then 'Parlamentarische Dokumente' when :en then 'Parliamentary documents' else 'Parlementaire stukken' end %>
          <span class="font-normal text-gray-500 dark:text-gray-400">(<%= number_with_delimiter(@parliamentary_total_count) %>)</span>
        </h2>
        <svg class="search-section-chevron w-4 h-4 shrink-0 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <%# Results bar with sort %>
      <div class="search-results-tools flex items-center justify-between px-4 py-2 border-b border-gray-100 dark:border-gray-700/50">
        <span class="text-xs text-gray-500 dark:text-gray-400 font-medium">
          <%= t(:results_found, count: @parliamentary_total_count) %>
        </span>
        <div class="relative inline-block text-left" data-controller="dropdown">
          <button type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-sky/10 focus:outline-hidden focus:ring-2 focus:ring-offset-1 focus:ring-(--accent-500)" data-action="click->dropdown#toggle" data-dropdown-target="button" aria-haspopup="true">
            <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h9m5-4v12m0 0l-4-4m4 4l4-4"/>
            </svg>
            <span><%= t(:sort_order) %>: <span class="font-semibold"><%= parl_sort_label %></span></span>
            <svg class="w-4 h-4 text-gray-400 transition-transform" data-dropdown-target="arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="hidden absolute right-0 z-20 mt-1 w-48 origin-top-right rounded-md bg-white dark:bg-gray-800 shadow-lg ring-1 ring-black/5 dark:ring-sky/30 focus:outline-hidden" data-dropdown-target="menu" role="menu">
            <div class="py-1" role="none">
              <% [['date_desc', (case I18n.locale when :fr then 'Date ↓ (récent)' when :de then 'Datum ↓ (neueste)' when :en then 'Date ↓ (newest)' else 'Datum ↓ (nieuwste)' end)], ['date_asc', (case I18n.locale when :fr then 'Date ↑ (ancien)' when :de then 'Datum ↑ (älteste)' when :en then 'Date ↑ (oldest)' else 'Datum ↑ (oudste)' end)]].each do |key, label| %>
                <% is_current = parl_sort == key %>
                <% sort_params = request.query_parameters.except('frame', 'parl_page').merge(parl_sort: key) %>
                <%= link_to laws_path(sort_params), class: "flex items-center px-4 py-2 text-sm #{is_current ? 'bg-(--accent-50) dark:bg-(--accent-500)/20 text-(--accent-700) dark:text-(--accent-400) font-medium' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-sky/10'}", role: "menuitem", data: { turbo_frame: 'search_results', turbo_action: 'advance' } do %>
                  <% if is_current %>
                    <svg class="w-4 h-4 mr-2 text-(--accent-600)" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  <% else %>
                    <span class="w-4 mr-2"></span>
                  <% end %>
                  <%= label %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      <div class="overflow-x-auto w-full">
        <table role="table" class="w-full results-table results-table--parliamentary" aria-label="<%= t('related_sources.parliamentary.heading') %>">
          <thead role="rowgroup" class="bg-linear-to-r from-(--accent-500)/5 to-(--accent-500)/10 dark:from-(--accent-500)/20 dark:to-(--accent-500)/30">
            <tr role="row" class="border-b-2 border-(--accent-500)/20 dark:border-(--accent-500)/50">
              <th role="columnheader" scope="col" class="w-28 px-2 py-3 text-center text-xs leading-4 font-medium text-gray-700 dark:text-gray-300 tracking-wider whitespace-nowrap">
                <%= case I18n.locale when :fr then 'Date' when :de then 'Datum' when :en then 'Date' else 'Datum' end %>
              </th>
              <th role="columnheader" scope="col" class="w-36 px-2 py-3 text-center text-xs leading-4 font-medium text-gray-700 dark:text-gray-300 tracking-wider whitespace-nowrap">
                <%= case I18n.locale when :fr then 'Parlement' when :de then 'Parlament' when :en then 'Parliament' else 'Parlement' end %>
              </th>
              <th role="columnheader" scope="col" class="w-full px-4 py-3 text-left text-xs leading-4 font-medium text-gray-700 dark:text-gray-300 tracking-wider">
                <%= case I18n.locale when :fr then 'Titre / Document' when :de then 'Titel / Dokument' when :en then 'Title / Document' else 'Titel / Document' end %>
              </th>
              <th role="columnheader" scope="col" class="w-10 px-1 py-3 text-center text-xs leading-4 font-medium text-gray-700 dark:text-gray-300 tracking-wider whitespace-nowrap no-print">
                <span class="sr-only"><%= t('bookmarks.title') %></span>
                <span class="inline-flex items-center justify-center w-6 h-6 mx-auto">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" title="<%= t('bookmarks.title') %>">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                  </svg>
                </span>
              </th>
            </tr>
          </thead>
          <tbody role="rowgroup" class="divide-y divide-gray-100 dark:divide-(--border-divider) dark:bg-gray-800">
            <% @parliamentary_results.each_with_index do |result, idx| %>
              <%
                raw_title = result[:title].to_s.strip
                has_useful_title = raw_title.present? &&
                                   raw_title != result[:document_number] &&
                                   raw_title != result[:dossier_number] &&
                                   !ParliamentaryHelper.generic_parl_title?(raw_title)
              %>
              <tr role="row" class="<%= idx.odd? ? 'bg-white dark:bg-gray-800' : 'bg-gray-50 dark:bg-gray-900' %> hover:bg-(--accent-active-bg) transition-colors duration-200">
                <td role="cell" class="result-date w-28 px-2 py-3 align-top text-sm leading-5 font-medium text-gray-700 dark:text-gray-300 text-center whitespace-nowrap">
                  <span class="badge-date">
                    <% if result[:date].present? %>
                      <% begin %>
                        <%= Date.parse(result[:date]).strftime('%d/%m/%Y') %>
                      <% rescue %>
                        <%= result[:date] %>
                      <% end %>
                    <% else %>
                      –
                    <% end %>
                  </span>
                </td>
                <td role="cell" class="result-meta w-36 px-2 py-3 align-top text-xs leading-5 text-gray-500 dark:text-gray-400 text-center whitespace-nowrap">
                  <%= parliament_labels[result[:parliament]] || result[:parliament]&.capitalize %>
                </td>
                <td role="cell" class="result-content w-full px-4 py-3 align-top whitespace-normal text-sm leading-5 text-gray-900 dark:text-gray-300">
                  <a data-turbo-frame="_top" href="<%= parliamentary_path(result[:id]) %>" class="font-medium text-(--accent-700) dark:text-(--accent-400) hover:underline">
                    <% if has_useful_title %>
                      <%= raw_title %>
                    <% else %>
                      <% doc_label = result[:document_number].present? ? result[:document_number] : nil %>
                      <% dos_label = result[:dossier_number].present? ? "Dossier #{result[:dossier_number]}" : nil %>
                      <%= [dos_label, doc_label].compact.join(' – ').presence || 'Parlementair document' %>
                    <% end %>
                  </a>
                  <% if result[:content_preview].present? %>
                    <% clean_preview = result[:content_preview].gsub(/(\S) (?=\S )/){ $1 }.gsub(/\s{2,}/, ' ').strip %>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 line-clamp-2"><%= truncate(clean_preview, length: 150) %></p>
                  <% end %>
                </td>
                <td role="cell" class="result-action w-10 px-1 py-3 align-top text-center whitespace-nowrap no-print">
                  <button type="button"
                    class="bookmark-btn inline-flex items-center justify-center w-6 h-6 mx-auto text-gray-400 hover:text-(--accent-500) dark:text-gray-500 dark:hover:text-(--accent-400) transition-colors duration-200"
                    data-controller="bookmark"
                    data-bookmark-numac-value="parl:<%= result[:id] %>"
                    data-bookmark-title-value="<%= escape_once((result[:title].presence || result[:dossier_number].to_s).truncate(200)) %>"
                    data-action="click->bookmark#toggle"
                    title="<%= t('bookmarks.add') %>">
                    <svg data-bookmark-target="icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                    </svg>
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @parl_pagy && @parl_pagy.last > 1 %>
        <div class="flex items-center justify-between px-4 sm:px-6 py-3 bg-white dark:bg-gray-800">
          <div class="flex-1">
            <%= render 'shared/pagy/nav', pagy: @parl_pagy, frame_target: 'search_results' %>
          </div>
        </div>
      <% end %>
    </details>
  <% elsif @parliamentary_searched %>
    <%= render 'laws/source_empty_state', source: :parliamentary, timed_out: @parliamentary_timed_out %>
  <% end %>
  </div><%# the results landmark %>
</div>
<% end %>
