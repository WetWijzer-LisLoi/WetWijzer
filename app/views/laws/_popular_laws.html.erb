<%# Cached BELOW the header, not around it. The header's NL/FR toggle (lexlibera)
    builds its links from request.query_parameters; inside the fragment that baked
    the FIRST visitor's query string into every later visitor's page for a day.
    The header is static markup and costs nothing to render each time.

    The key carries stamps for everything the block reads that this request has
    not loaded: the laws, jurisprudence and chamber databases (main-file mtimes,
    which move at checkpoint after each write) and the three concordance YAML
    files. Nothing here is preloaded by the controller, so a row digest would
    cost the very queries the cache exists to skip; the stamps are the honest
    cheap signal. 1-day TTL stays as the backstop.

    popular_laws_code_version is a content digest of popular_laws_helper.rb,
    which renders every cell here. Rails folds the TEMPLATE digest into the key
    but knows nothing about helpers, and the file store outlives a deploy - so a
    helper-only fix shipped green and reached nobody until this was added. %>
<% cache ["popular_laws", "v14", I18n.locale, content_lang, collapsed,
          laws_db_version, popular_laws_code_version,
          files_version(FisconetSearchService::FISCONET_DB_PATH,
                        ENV.fetch('JURISPRUDENCE_SOURCE_DB') { Rails.root.join('storage/jurisprudence.db') },
                        ENV.fetch('CHAMBER_DB') { Rails.root.join('storage/chamber.sqlite3') },
                        Rails.root.join('config/data/bw_concordance.yml'),
                        Rails.root.join('config/data/sw_concordance.yml'),
                        Rails.root.join('config/data/wvv_concordance.yml'))],
         expires_in: 1.day do %>
<%
  # Is this popular law abolished or empty? Looked up per link, memoised for
  # the render: one indexed probe on (numac, language_id) each, ~90 per render,
  # once a day per variant. It used to be one query over is_core = 1 laws, but
  # 37 of the 91 laws linked here are not flagged core, so an abolition of one
  # of those could never have struck it through.
  lang_id = current_language_id
  abolished_lookup = Hash.new do |memo, numac|
    memo[numac] = begin
      Legislation.where(numac: numac, language_id: lang_id)
                 .where('is_abolished = 1 OR is_empty_content = 1')
                 .exists?
    rescue StandardError
      false
    end
  end

  # Tax codes live in the fisconet corpus and their ids drift on merge, so the
  # links below resolve by document type at render time (see
  # FisconetSearchService.numacs_by_document_type). Empty when unavailable.
  fisconet_numacs = FisconetSearchService.numacs_by_document_type

  # Base CSS for all popular law links
  base_class = "text-sm text-gray-600 dark:text-gray-300 hover:text-(--accent-600) dark:hover:text-(--accent-400) transition-colors"
  # Helper to get the right classes for a given numac
  popular_law_class = ->(numac, extra: "") {
    if abolished_lookup[numac]
      "#{base_class} line-through text-gray-500 dark:text-gray-400 #{extra}".strip
    else
      "#{base_class} #{extra}".strip
    end
  }
  abolished_title = case I18n.locale
                    when :fr then 'Plus en vigueur / indisponible'
                    when :de then 'Nicht mehr in Kraft / nicht verfügbar'
                    when :en then 'No longer in force / unavailable'
                    else 'Niet meer van kracht / onbeschikbaar'
                    end
  popular_law_title = ->(numac) { abolished_lookup[numac] ? abolished_title : nil }

  # Recent-legislation type badge: the types table holds language-specific
  # ASCII codes ('wet', 'decret', 'arrete'); capitalising them put "Arrete" on
  # the French homepage. Translate through the same map the RSS helper uses.
  generic_type_label = case I18n.locale
                       when :fr then 'Législation'
                       when :de then 'Gesetzgebung'
                       when :en then 'Legislation'
                       else 'Wetgeving'
                       end
  type_label_for = ->(law) {
    key = RssHelper::LAW_TYPE_I18N_KEYS[law.type&.law_type.to_s]
    key && key != :misc ? t(key) : generic_type_label
  }
