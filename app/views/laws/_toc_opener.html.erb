<%# The contents button of the source toolbar, shown only from md to lg (768
    to 1023px): below md the mobile dock opens the contents sidebar, from lg
    the sliver at the left edge does, and since 2026-11-02 nothing below a
    long law's main contents does. The toolbar sits outside the sidebar-toggle
    controller, so toc_opener_controller.js reaches it through a window event. %>
<button type="button"
        class="source-detail-action hidden md:inline-flex lg:hidden items-center gap-1.5 px-2 py-1.5 md:px-3 text-xs md:text-sm font-medium rounded-lg text-(--accent-700) dark:text-(--accent-400) hover:bg-(--accent-500)/10 border border-(--accent-500)/20 transition-colors duration-150"
        data-controller="toc-opener"
        data-action="toc-opener#toggle"
        data-toc-opener
        aria-controls="toc-sidebar-panel"
        aria-expanded="false">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true">
    <path fill-rule="evenodd" d="M3.75 6.75a.75.75 0 01.75-.75h15a.75.75 0 010 1.5H4.5a.75.75 0 01-.75-.75zm0 5.25a.75.75 0 01.75-.75h15a.75.75 0 010 1.5H4.5a.75.75 0 01-.75-.75z" clip-rule="evenodd" />
  </svg>
  <span class="source-detail-label"><%= t(:toc).capitalize %></span>
</button>
