<%= content_for :title, t('account.activity_log') %>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto flex flex-col lg:flex-row gap-8">
    <%= render 'layouts/account_sidebar' %>

    <main class="flex-1 min-w-0">
    <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
      <%= account_icon(:clipboard) %> <%= t('account.activity_log') %>
    </h2>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden">
      <% if @activities.any? %>
        <div class="divide-y divide-gray-200 dark:divide-gray-700">
          <% @activities.each do |activity| %>
            <div class="p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex items-start min-w-0">
                  <div class="mr-3 mt-0.5 shrink-0">
                    <% case activity.action %>
                    <% when 'registered' %>
                      <span class="text-green-500">✦</span>
                    <% when 'login' %>
                      <span class="text-green-500"><svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span>
                    <% when 'failed_login' %>
                      <span class="text-red-500"><svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg></span>
                    <% when 'logout' %>
                      <span class="text-gray-400">↩</span>
                    <% when 'password_changed', 'password_reset_completed' %>
                      <span class="text-(--accent-500)"><%= account_icon(:key) %></span>
                    <% when 'account_locked' %>
                      <span class="text-red-500"><%= account_icon(:lock) %></span>
                    <% when 'otp_enabled', 'otp_disabled' %>
                      <span class="text-purple-500"><%= account_icon(:shield) %></span>
                    <% else %>
                      <span class="text-gray-400">•</span>
                    <% end %>
                  </div>
                  <div class="min-w-0">
                    <p class="font-medium text-gray-900 dark:text-white [overflow-wrap:anywhere]">
                      <%= t("account.activity.#{activity.action}", default: activity.action.humanize) %>
                      <%# ABA-007: the canonical brand of a creation/sign-in
                          event, safe-labelled, never the stored value raw. %>
                      <% if %w[registered login].include?(activity.action) && activity.try(:site_brand).present? %>
                        <span class="text-sm font-normal text-gray-500 dark:text-gray-400">
                          &middot; <%= t('account.activity.via_brand', brand: SiteBrand.label_for(activity.site_brand)) %>
                        </span>
                      <% end %>
                    </p>
                    <% if activity.user_agent.present? %>
                    <p class="text-sm text-gray-500 dark:text-gray-400">
                      <%= friendly_device_label(activity.user_agent) %>
                    </p>
                    <% end %>
                  </div>
                </div>
                <span class="text-xs text-gray-400 sm:whitespace-nowrap sm:shrink-0">
                  <%= time_ago_in_words(activity.created_at) %> <%= t('account.ago') %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-8 text-center text-gray-500 dark:text-gray-400">
          <%= t('account.no_activity') %>
        </div>
      <% end %>
    </div>
    </main>
  </div>
</div>
