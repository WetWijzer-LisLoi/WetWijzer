<%= content_for :title, t('account.billing_info') %>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8 px-4">
  <div class="max-w-6xl mx-auto flex flex-col lg:flex-row gap-8">
    <%= render 'layouts/account_sidebar' %>
    <main class="flex-1 min-w-0">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4"><%= t('account.billing_info') %></h2>
      <% if flash[:notice].present? %>
        <p role="status" class="mb-4 p-3 rounded border border-green-200 dark:border-green-800 text-green-800 dark:text-green-200"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert].present? %>
        <p role="alert" class="mb-4 p-3 rounded border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200"><%= flash[:alert] %></p>
      <% end %>
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6"><%= render 'billing_form', subscription: @subscription %></div>
    </main>
  </div>
</div>
