<%= content_for :title, t('account.edit_profile') %>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto flex flex-col lg:flex-row gap-8">
    <%= render 'layouts/account_sidebar' %>

    <main class="flex-1 min-w-0">
    <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
      <%= t('account.edit_profile') %>
    </h2>

    <% if flash[:alert] %>
      <div class="mb-4 p-4 bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-200 rounded-lg">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: account_path, method: :patch, class: "space-y-6" do |f| %>
      <!-- Name -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
          <%= t('account.profile_info') %>
        </h3>
        
        <div class="mb-4">
          <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            <%= t('auth.name') %>
          </label>
          <input type="text" 
                 name="name" 
                 id="name" 
                 value="<%= @user.name %>"
                 class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white focus:ring-2 focus:ring-(--accent-500) focus:border-transparent"
                 placeholder="<%= t('auth.name') %>">
        </div>
        
        <div class="text-sm text-gray-500 dark:text-gray-400">
          <strong><%= t('auth.email') %>:</strong> <%= @user.email %>
          <p class="text-xs mt-1"><%= t('account.email_cannot_change') %></p>
        </div>
      </div>

      <!-- Invoice Language Preference -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
          <%= account_icon(:globe) %> <%= t('account.invoice_language', default: 'Factuurtaal') %>
        </h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
          <%= t('account.invoice_language_desc', default: 'Kies de taal voor uw facturen. Standaard wordt de taal van de website gebruikt.') %>
        </p>

        <div class="mb-2">
          <label for="invoice_locale" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            <%= t('account.invoice_language', default: 'Factuurtaal') %>
          </label>
          <select name="invoice_locale" 
                  id="invoice_locale"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white focus:ring-2 focus:ring-(--accent-500) focus:border-transparent">
            <option value="" <%= 'selected' if @user.invoice_locale.blank? %>>
              <%= t('account.invoice_language_auto') %> (<%= invoice_language_label(@user.locale) %>)
            </option>
            <option value="nl" <%= 'selected' if @user.invoice_locale == 'nl' %>>Nederlands (Factuur)</option>
            <option value="fr" <%= 'selected' if @user.invoice_locale == 'fr' %>>Français (Facture)</option>
            <option value="de" <%= 'selected' if @user.invoice_locale == 'de' %>>Deutsch (Rechnung)</option>
            <option value="en" <%= 'selected' if @user.invoice_locale == 'en' %>>English (Invoice)</option>
          </select>
        </div>
        <p class="text-xs text-gray-400 dark:text-gray-500">
          <%= t('account.invoice_language_note', default: 'Toekomstige facturen worden in de gekozen taal opgesteld. Bestaande facturen wijzigen niet.') %>
        </p>

        <%# Which of our four sites is yours. Defaults to the one you signed up
            on, which is what most readers expect and never have to touch. The
            empty option is not "none" - it means "keep following my
            registration", stored as an ABSENT preference rather than a value. %>
        <div class="mb-2 mt-4">
          <label for="default_portal" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            <%= t('account.default_portal', default: 'Standaard portaal') %>
          </label>
          <% current_portal = @user.ui_prefs[BrandMailerIdentity::PREFERENCE_KEY] %>
          <select name="default_portal"
                  id="default_portal"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white focus:ring-2 focus:ring-(--accent-500) focus:border-transparent">
            <option value="" <%= 'selected' if current_portal.blank? %>>
              <%= t('account.default_portal_auto', default: 'Automatisch') %>
              (<%= SiteBrand::LABELS[@user.registration_brand] || SiteBrand::LABELS['wetwijzer'] %>)
            </option>
            <% SiteBrand::KEYS.each do |brand_key| %>
              <option value="<%= brand_key %>" <%= 'selected' if current_portal == brand_key %>>
                <%= SiteBrand::LABELS[brand_key] %> (<%= SiteBrand::CANONICAL_DOMAINS[brand_key] %>)
              </option>
            <% end %>
          </select>
        </div>
        <p class="text-xs text-gray-400 dark:text-gray-500">
          <%= t('account.default_portal_note', default: 'Bepaalt welke site u e-mails stuurt en waar de links in die e-mails naartoe leiden. Standaard is dit de site waarop u zich registreerde.') %>
        </p>
      </div>

      <!-- Change Password -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
          <%= t('account.change_password') %>
        </h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
          <%= t('account.leave_blank_password') %>
        </p>
        
        <div class="space-y-4">
          <div data-controller="password-visibility">
            <label for="current_password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              <%= t('account.current_password') %>
            </label>
            <div class="relative">
              <input type="password" 
                     name="current_password" 
                     id="current_password"
                     autocomplete="current-password"
                     data-password-visibility-target="input"
                     class="w-full px-3 py-2 pr-10 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white focus:ring-2 focus:ring-(--accent-500) focus:border-transparent">
              <%= render 'shared/password_toggle' %>
            </div>
          </div>
          
          <div data-controller="password-strength password-visibility"
               data-password-strength-labels-value="<%= t('auth.password_strength.labels').to_json %>"
               data-password-strength-requirements-value="<%= t('auth.password_strength.requirements').to_json %>"
               data-password-strength-empty-value="<%= t('auth.password_strength.empty') %>">
            <label for="password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              <%= t('account.new_password') %>
            </label>
            <div class="relative">
              <input type="password" 
                     name="password" 
                     id="password"
                     autocomplete="new-password"
                     data-password-visibility-target="input"
                     data-password-strength-target="input"
                     data-action="input->password-strength#check"
                     minlength="8"
                     class="w-full px-3 py-2 pr-10 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white focus:ring-2 focus:ring-(--accent-500) focus:border-transparent">
              <%= render 'shared/password_toggle' %>
            </div>
            <div id="pw-strength" class="mt-2">
              <div class="w-full h-2 bg-gray-200 dark:bg-gray-600 rounded-full overflow-hidden">
                <div id="pw-strength-bar" data-password-strength-target="meter" role="progressbar" aria-label="<%= t('auth.password_strength.label') %>" aria-valuemin="0" aria-valuemax="4" aria-valuenow="0" aria-valuetext="<%= t('auth.password_strength.empty') %>" class="h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
              </div>
              <span id="pw-strength-label" data-password-strength-target="text" role="status" aria-live="polite" aria-atomic="true" class="text-xs mt-1"></span>
              <div data-password-strength-target="requirements" class="mt-2 flex flex-wrap"><% t('auth.password_strength.requirements').each_value do |requirement| %><span class="text-gray-400 text-xs mr-3"><%= requirement %></span><% end %></div>
            </div>
          </div>
          
          <div data-controller="password-visibility">
            <label for="password_confirmation" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              <%= t('account.confirm_password') %>
            </label>
            <div class="relative">
              <input type="password" 
                     name="password_confirmation" 
                     id="password_confirmation"
                     autocomplete="new-password"
                     data-password-visibility-target="input"
                     class="w-full px-3 py-2 pr-10 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white focus:ring-2 focus:ring-(--accent-500) focus:border-transparent">
              <%= render 'shared/password_toggle' %>
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <%= link_to account_path, class: "text-gray-600 dark:text-gray-400 hover:underline" do %>
          ← <%= t('common.cancel') %>
        <% end %>
        
        <button type="submit" class="px-6 py-2 bg-(--accent-600-solid) text-white font-medium rounded-lg hover:bg-(--accent-700-solid) transition">
          <%= t('common.save') %>
        </button>
      </div>
    <% end %>
    <section class="mt-8 bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2"><%= t('account.billing_info') %></h3>
      <%= render 'billing_form', subscription: @subscription %>
    </section>
    </main>
  </div>
</div>
