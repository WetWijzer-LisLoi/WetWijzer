  <%# GDPR consent modal — must be INSIDE the data-controller="chatbot" div for
      its accept/decline data-actions to route. position:fixed, so DOM placement
      doesn't affect the widget layout. Never double-rendered: the layout only
      renders this widget when controller_name != 'chatbot'. %>
  <%= render 'chatbot/consent_modal' %>
</div>
<script nonce="<%= content_security_policy_nonce %>">
  // Context-aware toast on content pages - shows a small notification near the FAB
  // Supports: law pages, jurisprudence case pages, parliamentary document pages
  (function() {
    var ctxMeta = document.querySelector('meta[name="chatbot-context"]');
    if (!ctxMeta) return; // Not a content page - skip

    // Only show once per page navigation
    if (window._chatbotToastShown) return;

    var lang = document.documentElement.lang || 'nl';
    var contextType = ctxMeta.dataset.contextType || 'law';
    var msg;

    if (contextType === 'jurisprudence') {
      // Case law page - offer "brass tacks" analysis
      var court = ctxMeta.dataset.caseCourt || '';
      var caseNum = ctxMeta.dataset.caseNumber || '';
      var shortRef = court + (caseNum ? ' ' + caseNum.split(':').pop() : '');
      msg = {
        nl: { line: '⚖️ Ik zie dat u een arrest van <span class="toast-law-title">' + shortRef + '</span> leest.', cta: 'Geef me de kern van deze zaak!' },
        fr: { line: '⚖️ Je vois que vous lisez un arrêt de <span class="toast-law-title">' + shortRef + '</span>.', cta: 'Donnez-moi l\'essentiel de cette affaire !' },
        de: { line: '⚖️ Ich sehe, dass Sie ein Urteil von <span class="toast-law-title">' + shortRef + '</span> lesen.', cta: 'Geben Sie mir das Wesentliche dieses Falles!' },
        en: { line: '⚖️ I see you\'re reading a <span class="toast-law-title">' + shortRef + '</span> ruling.', cta: 'Give me the brass tacks of this case!' }
      };
    } else if (contextType === 'parliamentary') {
      // Parliamentary document - offer summary
      var docTitle = ctxMeta.dataset.docTitle || '';
      var docParl = ctxMeta.dataset.docParliament || '';
      var shortTitle = docTitle.length > 60 ? docTitle.substring(0, 57) + '…' : docTitle;
      msg = {
        nl: { line: '🏛️ Ik zie dat u een parlementair stuk van <span class="toast-law-title">' + docParl + '</span> bekijkt.', cta: 'Vat dit document voor mij samen!' },
        fr: { line: '🏛️ Je vois que vous consultez un document parlementaire (<span class="toast-law-title">' + docParl + '</span>).', cta: 'Résumez ce document pour moi !' },
        de: { line: '🏛️ Ich sehe, dass Sie ein parlamentarisches Dokument (<span class="toast-law-title">' + docParl + '</span>) ansehen.', cta: 'Fassen Sie dieses Dokument für mich zusammen!' },
        en: { line: '🏛️ I see you\'re viewing a parliamentary document from <span class="toast-law-title">' + docParl + '</span>.', cta: 'Summarize this document for me!' }
      };
    } else {
      // Law page (default) - existing behavior
      var lawTitle = ctxMeta.dataset.lawTitle;
      if (!lawTitle) return;
      msg = {
        nl: { line: '📜 Ik zie dat u <span class="toast-law-title">' + lawTitle + '</span> bekijkt.', cta: 'Stel mij gerust uw vragen hierover!' },
        fr: { line: '📜 Je vois que vous consultez <span class="toast-law-title">' + lawTitle + '</span>.', cta: 'Posez-moi vos questions à ce sujet!' },
        de: { line: '📜 Ich sehe, dass Sie <span class="toast-law-title">' + lawTitle + '</span> ansehen.', cta: 'Stellen Sie mir Ihre Fragen dazu!' },
        en: { line: '📜 I see you\'re viewing <span class="toast-law-title">' + lawTitle + '</span>.', cta: 'Ask me anything about it!' }
      };
    }

    var localMsg = msg[lang] || msg.nl;

    function showToast() {
      // Mobile: suppress entirely. The "I see you're viewing X" toast reappeared
      // on every law page (Turbo re-runs this script) and, sitting over page
      // content on a small screen, an accidental tap opened the full chat panel
      // — "keeps popping up and blocks everything". The FAB / bottom-bar Chat
      // button is enough on mobile.
      if (window.matchMedia && window.matchMedia('(max-width: 640px)').matches) return;
      // Desktop: show at most once per session (was re-showing every navigation).
      if (window._chatbotToastShown) return;
      window._chatbotToastShown = true;
      var toast = document.getElementById('chatbot-context-toast');
      if (!toast) return;

      // Don't show if chat panel is already open
      var panel = document.getElementById('chatbot-widget-panel');
      if (panel && !panel.classList.contains('hidden')) return;

      // Build toast content
      toast.innerHTML = '<span class="toast-close" title="Close">&times;</span>' +
                        '<div>' + localMsg.line + '</div>' +
                        '<span class="toast-cta">' + localMsg.cta + '</span>';

      // Show with animation
      toast.classList.remove('hidden', 'toast-exit');
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          toast.classList.add('toast-visible');
        });
      });

      // Click toast body → open chat panel
      toast.addEventListener('click', function(e) {
        if (e.target.classList.contains('toast-close')) {
          dismissToast();
          return;
        }
        dismissToast();
        // Open the chatbot panel
        var ctrlEl = document.querySelector('[data-controller~="chatbot"]');
        if (ctrlEl) {
          var app = window.Stimulus || (window.Application && window.Application.application);
          if (app) {
            var ctrl = app.getControllerForElementAndIdentifier(ctrlEl, 'chatbot');
            if (ctrl && typeof ctrl.toggle === 'function') {
              ctrl.toggle();
            }
          }
        }
      });

      // Auto-dismiss after 8 seconds
      window._chatbotToastTimer = setTimeout(dismissToast, 8000);
    }

    function dismissToast() {
      clearTimeout(window._chatbotToastTimer);
      var toast = document.getElementById('chatbot-context-toast');
      if (!toast) return;
      toast.classList.remove('toast-visible');
      toast.classList.add('toast-exit');
      setTimeout(function() { toast.classList.add('hidden'); }, 250);
    }

    // Law pages: wait for turbo frame; jurisprudence/parliamentary: show after 1.5s
    if (contextType === 'law') {
      var frame = document.querySelector('turbo-frame#law_articles');
      if (frame) {
        frame.addEventListener('turbo:frame-load', function() {
          setTimeout(showToast, 600);
        }, { once: true });
        // Fallback: if frame already loaded (cached), show after 3s
        setTimeout(function() {
          if (!window._chatbotToastShown) showToast();
        }, 3000);
      } else {
        // No frame (e.g., fisconet page)
        setTimeout(showToast, 1500);
      }
    } else {
      // Jurisprudence and parliamentary pages - show after 1.5s
      setTimeout(showToast, 1500);
    }
  })();
</script>

<%# Mobile PWA: keep the widget inside the VISIBLE viewport.

    Measured on the owner's installed PWA (2026-08-19): the layout viewport is
    466px wide while only 411px is visible (visualViewport.width=411,
    offsetLeft up to 54, scale=1). A position:fixed element resolves its
    offsets against the LAYOUT viewport, so `right: 1rem` put the FAB at
    x=398..450 - past the visible edge, leaving a sliver of it tappable.

    Offset the container by however much of the layout viewport is hidden on
    the right, and follow the visual viewport as it pans. Kept free of ERB so
    test/javascript/chatbot_widget_visual_viewport_test.mjs can extract and
    execute it directly. %>
<script nonce="<%= content_security_policy_nonce %>">
/* ww-visual-viewport-pin:start */
(function () {
  var MOBILE = '(max-width: 640px)';

  // Pixels of the layout viewport hidden beyond the visible right edge, plus
  // the inset the design asks for. null means "nothing hidden, use the CSS".
  function computeInset(layoutWidth, visibleOffset, visibleWidth, base) {
    var hidden = Math.round(layoutWidth - (visibleOffset + visibleWidth));
    if (!(hidden > 1)) return null;
    return hidden + base;
  }

  function pin() {
    var vv = window.visualViewport;
    var box = document.getElementById('chatbot-widget-container');
    if (!vv || !box) return;
    // Desktop, and a widget the user dragged, keep their own positioning.
    if (!window.matchMedia(MOBILE).matches ||
        (box.className || '').indexOf('widget-custom-pos') !== -1) {
      box.style.removeProperty('right');
      return;
    }
    // A docked bottom bar pins the widget flush right (right: 0).
    var base = document.getElementById('mobile-bottom-bar') ? 0 : 16;
    var inset = computeInset(window.innerWidth, vv.offsetLeft, vv.width, base);
    if (inset === null) { box.style.removeProperty('right'); }
    else { box.style.setProperty('right', inset + 'px', 'important'); }
  }

  window.__wwWidgetPin = { compute: computeInset, pin: pin };
  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', pin);
    window.visualViewport.addEventListener('scroll', pin);
  }
  window.addEventListener('orientationchange', pin);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', pin);
  } else { pin(); }
})();
/* ww-visual-viewport-pin:end */
</script>
