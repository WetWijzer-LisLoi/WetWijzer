<%# Floating chatbot widget - WhatsApp-style chat bubble %>
<%
  # Pre-compute localized strings for accessibility
  widget_title_text = case I18n.locale when :fr then "LisLoi Chatbot Juridique" when :de then "GesetzGuide Juristischer Chatbot" when :en then "LexLibera Legal Chatbot" else "WetWijzer Juridische Chatbot" end
  open_label  = case I18n.locale when :fr then 'Ouvrir le chatbot juridique' when :de then 'Juristischen Chatbot öffnen' when :en then 'Open legal chatbot' else 'Juridische chatbot openen' end
  close_label = case I18n.locale when :fr then 'Fermer le chatbot' when :de then 'Chatbot schließen' when :en then 'Close chatbot' else 'Chatbot sluiten' end
  send_label  = case I18n.locale when :fr then 'Envoyer le message' when :de then 'Nachricht senden' when :en then 'Send message' else 'Bericht versturen' end
  tooltip_text = case I18n.locale when :fr then 'LisLoi Chatbot Juridique' when :de then 'GesetzGuide Juristischer Chatbot' when :en then 'LexLibera Legal Chatbot' else 'WetWijzer Juridische Chatbot' end
  subtitle_text = case I18n.locale when :fr then 'Alimenté par IA' when :de then 'KI-gestützt' when :en then 'AI-powered' else 'AI-gestuurd' end

  messages_label = case I18n.locale when :fr then 'Messages du chatbot' when :de then 'Chatbot-Nachrichten' when :en then 'Chatbot messages' else 'Chatbot berichten' end
%>
<div id="chatbot-widget-container"
     class="fixed bottom-6 right-6 z-50 no-print"
     data-controller="chatbot"
     data-chatbot-language-value="<%= I18n.locale %>"
     data-chatbot-source-value="legislation"
     data-chatbot-use-local-value="false"
     <%# The FLOATING widget must start COLLAPSED (just the FAB). A prior commit
         "Auto-open chatbot widget on page load" set this to true, which opened
         the panel on every page — a 400px corner box on desktop but a
         full-screen block on mobile. The dedicated /chatbot page (index.html.erb)
         keeps open=true; the floating widget does not. %>
     data-chatbot-open-value="false"
     data-chatbot-has-credits-value="<%= current_user && current_user.credits.to_i > 0 ? 'true' : 'false' %>"
     data-chatbot-praxis-linked-value="<%= current_user&.praxis_linked_at.present? ? 'true' : 'false' %>"
     data-chatbot-pro-value="<%= current_user&.advanced_intelligence_access? ? 'true' : 'false' %>">

  <%# Auth state for JS - enables server-side conversation/bookmark persistence in widget %>
  <div id="chatbot-auth-state" class="hidden"
       data-logged-in="<%= current_user ? 'true' : 'false' %>"
       data-consent="<%= current_user&.conversation_storage_consented? ? 'true' : 'false' %>"></div>

  <style nonce="<%= content_security_policy_nonce %>">
    /* Widget animations */
    .chatbot-widget-enter {
      animation: widgetSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .chatbot-widget-exit {
      animation: widgetSlideDown 0.2s cubic-bezier(0.4, 0, 1, 1) forwards;
    }
    @keyframes widgetSlideUp {
      from { opacity: 0; transform: translateY(16px) scale(0.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes widgetSlideDown {
      from { opacity: 1; transform: translateY(0) scale(1); }
      to { opacity: 0; transform: translateY(16px) scale(0.95); }
    }
    .message-fade-in {
      animation: messageFadeIn 0.3s ease-out forwards;
    }
    @keyframes messageFadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    /* Pulse animation for the FAB when first appearing */
    .chatbot-fab-pulse {
      animation: fabEntrance 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
                 fabPulse 2s ease-in-out 1.6s 3;
    }
    @keyframes fabEntrance {
      0%   { opacity: 0; transform: scale(0.3) translateY(20px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }
    @keyframes fabPulse {
      0%, 100% { box-shadow: 0 4px 14px rgba(0,0,0,0.15); transform: scale(1); }
      50% { box-shadow: 0 4px 24px rgba(var(--accent-rgb, 37 99 235), 0.5); transform: scale(1.08); }
    }
    /* Bigger hover for the FAB */
    #chatbot-fab:hover {
      transform: scale(1.2) !important;
      box-shadow: 0 8px 30px rgba(var(--accent-rgb, 37 99 235), 0.4) !important;
    }
    /* Context toast notification - pops out of the FAB */
    #chatbot-context-toast {
      position: absolute;
      bottom: 100%;
      right: 0;
      margin-bottom: 12px;
      width: max-content;
      max-width: min(320px, calc(100vw - 3rem));
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 13px;
      line-height: 1.4;
      cursor: pointer;
      pointer-events: auto;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15), 0 0 0 1px rgba(255,255,255,0.05);
      background: linear-gradient(135deg, var(--accent-600-solid, #2563eb), var(--accent-700-solid, #1d4ed8));
      color: #fff;
      opacity: 0;
      transform: translateY(8px) scale(0.95);
      transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #chatbot-context-toast.toast-visible {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    /* On mobile with bottom bar, position toast above the bar */
    @media (max-width: 640px) {
      body:has(#mobile-bottom-bar) #chatbot-context-toast {
        position: fixed;
        bottom: 56px;
        right: 0.75rem;
        left: auto;
        margin-bottom: 0;
      }
      body:has(#mobile-bottom-bar) #chatbot-context-toast::after {
        display: none;
      }
    }
    #chatbot-context-toast.toast-exit {
      opacity: 0;
      transform: translateY(8px) scale(0.95);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    /* Small triangle pointer toward FAB */
    #chatbot-context-toast::after {
      content: '';
      position: absolute;
      bottom: -6px;
      right: 20px;
      width: 12px;
      height: 12px;
      background: var(--accent-700-solid, #1d4ed8);
      transform: rotate(45deg);
      border-radius: 0 0 3px 0;
    }
    #chatbot-context-toast .toast-law-title {
      font-weight: 600;
    }
    #chatbot-context-toast .toast-cta {
      display: block;
      margin-top: 4px;
      font-size: 11px;
      opacity: 0.75;
    }
    #chatbot-context-toast .toast-close {
      position: absolute;
      top: 4px;
      right: 6px;
      width: 18px;
      height: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      font-size: 14px;
      line-height: 1;
      color: rgba(255,255,255,0.6);
      cursor: pointer;
      transition: color 0.15s, background 0.15s;
    }
    #chatbot-context-toast .toast-close:hover {
      color: #fff;
      background: rgba(255,255,255,0.15);
    }

    /* Smooth textarea auto-resize */
    #chatbot-widget-container textarea {
      min-height: 38px;
      max-height: 100px;
    }
    /* Messages area - vertically resizable */
    #chatbot-widget-panel [data-chatbot-target="messages"] {
      resize: none;
      overflow-y: auto;
      min-height: 120px;
    }
    /* Default panel size - max-height in CSS so JS can safely clear inline styles */
    #chatbot-widget-panel {
      max-height: min(520px, calc(100dvh - 120px));
      transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                  width 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                  height 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    /* Expanded mode - much larger panel */
    #chatbot-widget-panel.widget-expanded {
      max-height: calc(100dvh - 100px) !important;
      height: calc(100dvh - 100px) !important;
      width: min(800px, calc(100vw - 2rem)) !important;
    }
    #chatbot-widget-panel.widget-expanded [data-chatbot-target="messages"] {
      min-height: 400px;
    }
    /* Drag handle cursor on header */
    .widget-drag-handle {
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
    }
    .widget-drag-handle:active,
    .widget-dragging .widget-drag-handle {
      cursor: grabbing;
    }
    /* Prevent text selection during drag/resize */
    .widget-dragging,
    .widget-resizing {
      user-select: none !important;
      -webkit-user-select: none !important;
    }
    /* Resize handles - invisible edges and corners for all-direction resizing */
    .widget-resize-edge, .widget-resize-corner {
      position: absolute;
      z-index: 10;
    }
    .widget-resize-n { top: -3px; left: 8px; right: 8px; height: 6px; cursor: n-resize; }
    .widget-resize-s { bottom: -3px; left: 8px; right: 8px; height: 6px; cursor: s-resize; }
    .widget-resize-w { left: -3px; top: 8px; bottom: 8px; width: 6px; cursor: w-resize; }
    .widget-resize-e { right: -3px; top: 8px; bottom: 8px; width: 6px; cursor: e-resize; }
    .widget-resize-nw { top: -4px; left: -4px; width: 12px; height: 12px; cursor: nw-resize; }
    .widget-resize-ne { top: -4px; right: -4px; width: 12px; height: 12px; cursor: ne-resize; }
    .widget-resize-sw { bottom: -4px; left: -4px; width: 12px; height: 12px; cursor: sw-resize; }
    .widget-resize-se { bottom: -4px; right: -4px; width: 12px; height: 12px; cursor: se-resize; }
    /* When widget is custom-positioned, use fixed positioning for container */
    #chatbot-widget-container.widget-custom-pos {
      bottom: auto !important;
      right: auto !important;
    }
    /* Mobile: full-width widget - override drag/resize */
    @media (max-width: 640px) {
      /* Default mobile FAB position - close to bottom edge */
      #chatbot-widget-container:not(.widget-custom-pos) {
        bottom: 1rem !important;
        right: 1rem !important;
      }
      /* Hide the floating FAB when the page has a docked bottom bar */
      body:has(#mobile-bottom-bar) #chatbot-fab {
        display: none !important;
      }
      /* Push chatbot panel above the bottom bar */
      body:has(#mobile-bottom-bar) #chatbot-widget-container:not(.widget-custom-pos) {
        bottom: 0 !important;
        right: 0 !important;
      }
      #chatbot-fab {
        width: 3.25rem !important;
        height: 3.25rem !important;
      }
      #chatbot-fab svg {
        width: 1.5rem !important;
        height: 1.5rem !important;
      }
      #chatbot-widget-panel {
        /* Full-screen chat on mobile so the page underneath is fully covered.
           It was a card with margins (100vw-1.5rem wide, bottom:70px, top gap),
           which left the homepage visible around it -> a confusing "double view". */
        position: fixed !important;
        inset: 0 !important;
        /* NOT width: 100vw. The vw unit measures the layout viewport INCLUDING
           the scrollbar (and, in an edge-to-edge PWA, system insets), so it
           resolves WIDER than the visible area - measured live: 100vw = 500px
           against a 485px viewport, i.e. 15px of horizontal overflow that let
           the page pan sideways ("weirdly wide" on mobile, 2026-08-19).
           inset: 0 already stretches a fixed element to exactly the viewport;
           auto !important is needed because the resize feature writes an
           inline width that would otherwise win. */
        width: auto !important;
        height: 100dvh !important;
        max-width: none !important;
        max-height: none !important;
        border-radius: 0 !important;
      }
      /* Resize/drag affordances are meaningless on touch: the panel is
         fullscreen (inset: 0) so there is nothing to resize, and the handles
         sit a few px OUTSIDE the panel edge by design - at every phone width
         measured (320/360/390/414) they were the only elements extending past
         the viewport, which is what makes the page feel draggably wide.
         Remove them from layout on mobile rather than only changing cursor. */
      .widget-resize-edge, .widget-resize-corner { display: none !important; }
      .widget-drag-handle { cursor: default !important; }
      #chatbot-widget-container.widget-custom-pos {
        bottom: 1rem !important;
        right: 1rem !important;
        left: auto !important;
        top: auto !important;
      }
    }
    /* Print: hide widget */
    @media print {
      #chatbot-widget-container { display: none !important; }
    }
    /* Accessibility: respect reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .chatbot-widget-enter,
      .chatbot-widget-exit,
      .message-fade-in,
      .chatbot-fab-pulse {
        animation: none !important;
      }
      #chatbot-widget-container *,
      #chatbot-widget-container *::before,
      #chatbot-widget-container *::after {
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
      }
    }
    /* High-contrast focus ring for keyboard users */
    #chatbot-widget-container :focus-visible {
      outline: 3px solid var(--accent-500, #3b82f6) !important;
      outline-offset: 2px !important;
    }
    /* Ensure focus ring visible in dark mode */
    @media (prefers-color-scheme: dark) {
      #chatbot-widget-container :focus-visible {
        outline-color: var(--accent-400, #60a5fa) !important;
      }
    }
  </style>

  <%# Floating Action Button (FAB) %>
  <button type="button"
          id="chatbot-fab"
          data-chatbot-target="toggleButton"
          data-action="keydown->chatbot#handleFabKeydown mousedown->chatbot#startFabDrag touchstart->chatbot#startFabDrag"
          aria-label="<%= open_label %>"
          aria-expanded="false"
          aria-controls="chatbot-widget-panel"
          aria-haspopup="dialog"
          class="chatbot-fab-pulse group relative w-14 h-14 rounded-full shadow-lg flex items-center justify-center transition-all duration-300 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-(--accent-500) cursor-pointer"
          style="background: linear-gradient(135deg, var(--accent-600-solid, #2563eb), var(--accent-700-solid, #1d4ed8));">

    <%# Chat icon (shown when closed) %>
    <svg data-chatbot-target="fabIconChat" class="w-6 h-6 text-white transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
    </svg>
    <%# Close icon (shown when open) %>
    <svg data-chatbot-target="fabIconClose" class="w-6 h-6 text-white transition-transform duration-300 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
    <%# Notification badge %>
    <span class="hidden absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center font-bold shadow-sm"
          data-chatbot-target="badge"
          aria-label="1 nieuw bericht">1</span>
    <%# Tooltip - hidden from screen readers (redundant with aria-label) %>
    <span class="absolute right-full mr-3 px-3 py-1.5 bg-gray-900 dark:bg-gray-700 text-white text-xs font-medium rounded-lg whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none shadow-lg"
          aria-hidden="true"
          role="tooltip">
      <%= tooltip_text %>
    </span>
  </button>

  <%# Context-aware toast notification - shown on law pages instead of auto-opening the panel %>
  <div id="chatbot-context-toast" class="hidden" role="status" aria-live="polite"></div>

  <%# Chat Panel - dialog role with focus trap %>
  <div id="chatbot-widget-panel"
       class="hidden absolute bottom-[4.5rem] right-0 w-[400px] max-w-[calc(100vw-2rem)] bg-white dark:bg-[#0f172a] rounded-2xl shadow-2xl overflow-hidden border border-gray-200 dark:border-gray-700 flex flex-col"
       data-chatbot-target="widget"
       role="dialog"
       aria-modal="false"
       aria-label="<%= widget_title_text %>">

    <%# Header - also serves as drag handle for moving the widget %>
    <div class="shrink-0 px-4 py-3 flex items-center justify-between border-b border-gray-100 dark:border-gray-700 widget-drag-handle"
         data-action="mousedown->chatbot#startDrag touchstart->chatbot#startDrag dblclick->chatbot#resetWidgetLayout"
         style="background: linear-gradient(135deg, var(--accent-600-solid, #2563eb), var(--accent-700-solid, #1d4ed8));">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center" aria-hidden="true">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
          </svg>
        </div>
        <div>
          <span class="font-semibold text-white text-sm" id="chatbot-widget-title"><%= widget_title_text %></span>
          <span class="block text-[10px] text-white/70" aria-hidden="true">
            <%= subtitle_text %>
          </span>
        </div>
      </div>
      <div class="flex items-center gap-1" role="toolbar" aria-label="<%= case I18n.locale when :fr then 'Actions du chatbot' when :de then 'Chatbot-Aktionen' when :en then 'Chatbot actions' else 'Chatbot acties' end %>">

        <%# Reset position - snap widget back to original corner %>
        <button type="button"
                id="widget-reset-position-btn"
                data-action="click->chatbot#resetWidgetPosition"
                aria-label="<%= case I18n.locale when :fr then 'Position d\'origine' when :de then 'Ursprungsposition' when :en then 'Reset position' else 'Oorspronkelijke positie' end %>"
                title="<%= case I18n.locale when :fr then 'Position d\'origine' when :de then 'Ursprungsposition' when :en then 'Reset position' else 'Oorspronkelijke positie' end %>"
                class="p-1.5 hover:bg-white/20 rounded-lg transition-colors text-white/80 hover:text-white focus:bg-white/20 opacity-30 cursor-default pointer-events-none"
                disabled>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"/>
          </svg>
        </button>

        <%# Maximize / Restore toggle %>
        <button type="button"
                id="widget-maximize-btn"
                data-action="click->chatbot#resetWidgetLayout"
                aria-label="<%= case I18n.locale when :fr then 'Agrandir' when :de then 'Vergrößern' when :en then 'Maximize' else 'Vergroten' end %>"
                title="<%= case I18n.locale when :fr then 'Agrandir' when :de then 'Vergrößern' when :en then 'Maximize' else 'Vergroten' end %>"
                class="p-1.5 hover:bg-white/20 rounded-lg transition-colors text-white/80 hover:text-white cursor-pointer focus:bg-white/20">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="2"/>
          </svg>
        </button>

        <%# Minimize - hides widget but keeps position %>
        <button type="button"
                data-action="click->chatbot#toggle"
                aria-label="<%= close_label %>"
                class="p-1.5 hover:bg-white/20 rounded-lg transition-colors text-white/80 hover:text-white cursor-pointer focus:bg-white/20">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14"/>
          </svg>
        </button>
      </div>
    </div>

    <%# Messages area %>
    <div class="flex-1 overflow-y-auto p-3 space-y-3 bg-gray-50 dark:bg-[#080d19]"
         data-chatbot-target="messages"
         role="log"
         aria-live="polite"
         aria-label="<%= messages_label %>"
         aria-relevant="additions"
         tabindex="0"
         style="min-height: 200px;"></div>

    <%# Typing indicator %>
    <div class="hidden px-3 py-2 bg-gray-50 dark:bg-[#080d19]"
         data-chatbot-target="typingIndicator"
         role="status"
         aria-label="<%= t('chatbot.thinking', default: 'Aan het nadenken...') %>">
      <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400 text-sm">
        <div class="flex gap-1" aria-hidden="true">
          <span class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0ms"></span>
          <span class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 150ms"></span>
          <span class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 300ms"></span>
        </div>
        <span><%= t('chatbot.thinking', default: 'Aan het nadenken...') %></span>
      </div>
    </div>

    <%# Compact progress bar %>
    <div data-chatbot-target="loading" class="hidden px-3 py-2 bg-gray-50 dark:bg-[#080d19]" role="status">
      <div class="bg-gray-200 dark:bg-gray-700 rounded-full h-1.5 overflow-hidden">
        <div data-chatbot-target="progressBar"
             class="h-1.5 rounded-full transition-[width] duration-300"
             style="width: 0%; background: var(--accent-600-solid, #2563eb);"
             role="progressbar"
             aria-valuenow="0"
             aria-valuemin="0"
             aria-valuemax="100"></div>
      </div>
      <div data-chatbot-target="progressText" class="text-[10px] text-gray-400 dark:text-gray-500 text-center mt-1" aria-live="polite"></div>
    </div>

    <%# ── Collapsible Options Panel - ALL settings, compact ── %>
    <%
      intelligence_levels_widget = LegalChatbotService::INTELLIGENCE_LEVELS
      user_is_pro_widget = defined?(current_user) && current_user&.pro?
      user_has_purchased_widget = defined?(current_user) && current_user&.advanced_intelligence_access?
      user_logged_in_widget = defined?(current_user) && current_user.present?
      widget_model_tier = user_logged_in_widget ? current_user.current_tier : :free

    %>
    <div id="widget-options-panel"
         class="hidden shrink-0 border-t border-gray-200 dark:border-gray-700 bg-gray-50/80 dark:bg-[#0f172a]/90"
         data-chatbot-target="widgetOptionsPanel">
      <div class="px-3 py-2 space-y-1.5">

        <%# ROW 1: Intelligence pills (label + cost) %>
        <div class="flex items-center justify-between gap-1">
          <div class="flex items-center gap-0.5" id="widget-intelligence-pills">
            <% roman_numerals_w = %w[I II III IV] %>
            <% intelligence_levels_widget.each_with_index do |(level_id, config), widx| %>
              <% tier_locked = !LegalChatbotService.intelligence_tier_accessible?(
                   config[:tier], pro: user_is_pro_widget, purchased: user_has_purchased_widget
                 )
                 locked = tier_locked || config[:models].keys.none? { |model_id| LegalChatbotService.model_allowed?(model_id, widget_model_tier) } %>
              <% label = config[:labels][I18n.locale] || config[:labels][:nl] %>
              <% roman = roman_numerals_w[widx] || (widx + 1).to_s %>
              <button type="button"
                      class="widget-intel-pill relative flex items-center gap-0.5 px-1.5 py-1 rounded-md text-[10px] font-medium whitespace-nowrap transition-all duration-150 cursor-pointer
