    // ═══════════════════════════════════════════════
    // PERSISTENCE BRIDGE - syncs full-page UI with Stimulus chatbot controller
    // Uses PreferencesStore (in-memory for anon, server-API for logged-in)
    // This preferences bridge uses no browser persistence for anonymous users.
    // Separate documented PWA and encrypted ZK-retry storage are out of scope.
    // ═══════════════════════════════════════════════
    function saveChatbotPrefs(partial) {
      try {
        // Sync widget Stimulus controller attributes if present
        var widgetContainer = document.querySelector('[data-controller="chatbot"]');
        if (widgetContainer) {
          if (partial.intelligence) widgetContainer.setAttribute('data-chatbot-intelligence-value', partial.intelligence);
          if (partial.model) widgetContainer.setAttribute('data-chatbot-model-override-value', partial.model);
          // Profile/category intentionally NOT synced — resets to "general" each session.
          if (partial.source) widgetContainer.setAttribute('data-chatbot-source-value', partial.source);
        }
        // Persist via PreferencesStore if available (server-side for logged-in users)
        if (window.prefsStore) {
          window.prefsStore.set('chatbot_prefs', Object.assign(window.prefsStore.get('chatbot_prefs') || {}, partial));
        }
      } catch(e) { /* ignore */ }
    }
    
    // On page load: restore saved preferences into full-page UI elements
    (function restoreFullPagePrefs() {
      var prefs = window.prefsStore ? window.prefsStore.get('chatbot_prefs') : null;
      if (!prefs || Object.keys(prefs).length === 0) return;
      
      // Restore model dropdown
      if (prefs.model) {
        var modelSel = document.getElementById('model-select');
        if (modelSel) {
          var opt = modelSel.querySelector('option[value="' + prefs.model + '"]');
          if (opt && !opt.disabled && !opt.hidden) opt.selected = true;
        }
      }
      
      
      // Profile/category intentionally NOT restored — always starts at "general".
      // Auto-sets when user clicks a sample question.
    })();
    
    // Wire model-select change to save preferences
    (function() {
      var modelSel = document.getElementById('model-select');
      if (modelSel) {
        modelSel.addEventListener('change', function() {
          saveChatbotPrefs({ model: modelSel.value });
        });
      }
      // Profile/category intentionally NOT saved — resets to "general" each session.
    })();
