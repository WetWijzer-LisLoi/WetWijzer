    function getCategoryDisplay(cat, lang) {
      var catUpper = cat.toUpperCase().replace(/\s*\(\d+\)\s*$/, '').trim();
      
      // Compound categories like "ARBEIDSRECHT - INDIVIDUEEL"
      if (catUpper.includes(' - ')) {
        var parts = catUpper.split(' - ');
        var mainKey = parts[0].trim();
        var subKey = parts[1].trim();
        var mainLabel = categoryInfo[mainKey] ? (categoryInfo[mainKey][lang] || categoryInfo[mainKey].nl) : (mainKey.charAt(0) + mainKey.slice(1).toLowerCase());
        var subLabel = categoryInfo[subKey] ? (categoryInfo[subKey][lang] || categoryInfo[subKey].nl) : (subKey.charAt(0) + subKey.slice(1).toLowerCase());
        return mainLabel + ' – ' + subLabel;
      }
      
      // Exact match
      if (categoryInfo[catUpper]) {
        return categoryInfo[catUpper][lang] || categoryInfo[catUpper].nl;
      }
      
      // Longest-key includes match
      var bestKey = null;
      for (var key in categoryInfo) {
        if (catUpper.includes(key) && (!bestKey || key.length > bestKey.length)) {
          bestKey = key;
        }
      }
      if (bestKey) {
        return categoryInfo[bestKey][lang] || categoryInfo[bestKey].nl;
      }
      
      // Title-case fallback
      return cat.charAt(0).toUpperCase() + cat.slice(1).toLowerCase();
    }
    
    function getShortCategory(cat) {
      return cat.replace(/\s*\(\d+\)\s*$/, '').trim();
    }
    
    function filterQuestions() {
      var search = document.getElementById('question-search').value.toLowerCase();
      var category = document.getElementById('category-filter').value;
      
      var filtered = allQuestions.filter(function(q) {
        var matchSearch = !search || q.nl.toLowerCase().includes(search) || (q.en && q.en.toLowerCase().includes(search));
        // Parent-category prefix matching: selecting "ARBEIDSRECHT" matches
        // "ARBEIDSRECHT", "ARBEIDSRECHT - INDIVIDUEEL", "ARBEIDSRECHT - ONTSLAG", etc.
        var matchCategory = category === 'all' || q.category === category || q.category.startsWith(category + ' - ');
        return matchSearch && matchCategory;
      });
      
      document.getElementById('question-count').textContent = filtered.length;
      renderQuestions(filtered);
    }
    
    // Mapping from sidebar category keys to profile dropdown values
    var SIDEBAR_CAT_TO_PROFILE = {
      // ── Exact matches (1:1 mapping) ──
      'ARBEIDSRECHT':       'labor',
      'HUURRECHT':          'real_estate',
      'VASTGOEDRECHT':      'real_estate',
      'FAMILIERECHT':       'family',
      'ERFRECHT':           'family',
      'STRAFRECHT':         'criminal',
      'FISCAAL':            'tax',
      'VENNOOTSCHAPSRECHT': 'corporate',
      'CONSUMENTENRECHT':   'consumer',
      'VREEMDELINGENRECHT': 'migration',
      'SOCIALE ZEKERHEID':  'social',
      'BESTUURSRECHT':      'administrative',
      'PRIVACY':            'privacy',
      // ── Best-fit mappings (no exact profile) ──
      'BOUWEN':             'real_estate',    // construction → real estate domain
      'BURENRECHT':         'real_estate',    // neighbor disputes → real estate domain
      'ZAKENRECHT':         'real_estate',    // property law → real estate domain
      'VERKEERSRECHT':      'criminal',       // traffic law → criminal (most relevant profile)
      'DRUGS':              'criminal',       // drug offenses → criminal
      'PROCEDURERECHT':     'administrative', // procedural law → administrative
      'OVERHEID':           'administrative', // government → administrative
      'GRONDWET':           'administrative', // constitutional → administrative
      'MEDISCH':            'social',         // medical law → social security (healthcare)
      'VERZEKERINGEN':      'consumer',       // insurance → consumer protection
      'SCHULDEN':           'consumer',       // debt → consumer protection
      'INTERNET':           'privacy',        // internet law → privacy
      'INTELLECTUEEL':      'corporate',      // IP → corporate
      'SPORT':              'labor',          // sports law → labor (employment context)
      'DIEREN':             'consumer',       // animal law → consumer (pet ownership)
      'MILIEU':             'administrative', // environmental → administrative
      'DIVERSE':            'general',        // truly general questions
      'ALGEMEEN':           'general'         // general questions
    };

    // Category icons for visual consistency with chatbot pills
    var categoryIcons = {
      'ARBEIDSRECHT':       '⚖️',
      'HUURRECHT':          '🏠',
      'VASTGOEDRECHT':      '🏠',
      'FAMILIERECHT':       '👨‍👩‍👧',
      'ERFRECHT':           '📜',
      'STRAFRECHT':         '',
      'FISCAAL':            '💰',
      'VENNOOTSCHAPSRECHT': '🏢',
      'CONSUMENTENRECHT':   '🛒',
      'VREEMDELINGENRECHT': '🌍',
      'SOCIALE ZEKERHEID':  '🏥',
      'BESTUURSRECHT':      '🏛️',
      'PRIVACY':            '🔒',
      'ALGEMEEN':           '📋',
      'BOUWEN':             '🔨',
      'BURENRECHT':         '🏡',
      'DIEREN':             '🐾',
      'DIVERSE':            '📂',
      'DRUGS':              '🚫',
      'GRONDWET':           '📖',
      'INTELLECTUEEL':      '',
      'INTERNET':           '🌐',
      'MEDISCH':            '⚕️',
      'MILIEU':             '🌿',
      'OVERHEID':           '🏛️',
      'PROCEDURERECHT':     '📑',
      'SCHULDEN':           '💳',
      'SPORT':              '⚽',
      'VERKEERSRECHT':      '🚗',
      'VERZEKERINGEN':      '🛡️',
      'ZAKENRECHT':         '🏗️'
    };

    function getIconForCategory(cat) {
      var mainCat = cat.toUpperCase().split(' - ')[0].trim();
      return categoryIcons[mainCat] || '📋';
    }

    function getProfileForCategory(cat) {
      var mainCat = cat.toUpperCase().split(' - ')[0].trim();
      return SIDEBAR_CAT_TO_PROFILE[mainCat] || 'general';
    }

    function renderQuestions(questions) {
      var container = document.getElementById('questions-list');
      var t = translations[currentLang] || translations.nl;
      if (questions.length === 0) {
        container.innerHTML = '<div class="p-4 text-center text-gray-500">' + t.noQuestionsFound + '</div>';
        return;
      }
      
      var grouped = {};
      questions.forEach(function(q) {
        var shortCat = getShortCategory(q.category);
        if (!grouped[shortCat]) grouped[shortCat] = [];
        grouped[shortCat].push(q);
      });
      var catKeys = Object.keys(grouped);
      // Auto-expand if 3 or fewer categories, collapse if many
      var autoExpand = catKeys.length <= 3;

      var html = '';
      for (var cat in grouped) {
        var icon = getIconForCategory(cat);
        var display = getCategoryDisplay(cat, currentLang);
        var expandClass = autoExpand ? '' : ' hidden';
        var chevronClass = autoExpand ? ' rotate-180' : '';
        
        html += '<div class="sidebar-cat-group border-b border-gray-200 dark:border-[#1e293b]/50 last:border-0">';
        // Clickable category header
        html += '<button type="button" class="sidebar-cat-toggle w-full flex items-center gap-1.5 px-3 py-2 bg-gray-100/80 dark:bg-[#080d19] hover:bg-gray-200/80 dark:hover:bg-[#0c1526] transition-colors duration-150 text-left">';
        html += '<span class="text-xs font-semibold text-gray-700 dark:text-gray-300 flex-1">' + icon + ' ' + display + ' <span class="text-gray-400 dark:text-gray-500 font-normal">(' + grouped[cat].length + ')</span></span>';
        html += '<svg class="sidebar-chevron w-3.5 h-3.5 text-gray-400 dark:text-gray-500 transition-transform duration-200' + chevronClass + '" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>';
        html += '</button>';
        // Collapsible question list
        html += '<ul class="sidebar-cat-body divide-y divide-gray-100 dark:divide-[#1e293b]/40' + expandClass + '">';
        grouped[cat].forEach(function(q) {
          var displayText = (currentLang !== 'nl' && q[currentLang]) ? q[currentLang] : q.nl;
           html += '<li><button type="button" class="w-full text-left px-3 py-2 text-sm text-(--accent-600) dark:text-(--accent-400) hover:bg-(--accent-50,#eff6ff) dark:hover:bg-[#0f172a] sample-question transition-colors duration-150" data-question="' + displayText.replace(/"/g, '&quot;') + '" data-category="' + cat + '"><span class="opacity-40 mr-1.5">→</span>' + displayText + '</button></li>';
        });
        html += '</ul></div>';
      }
      container.innerHTML = html;
      
      // Wire up accordion toggles
      container.querySelectorAll('.sidebar-cat-toggle').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var body = this.nextElementSibling;
          var chevron = this.querySelector('.sidebar-chevron');
          if (body) body.classList.toggle('hidden');
          if (chevron) chevron.classList.toggle('rotate-180');
        });
      });
      
      // Re-attach click handlers with category auto-select
      container.querySelectorAll('.sample-question').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var question = this.getAttribute('data-question');
          var category = this.getAttribute('data-category');
          var input = document.querySelector('[data-chatbot-target="input"]');
          if (input) {
            input.value = question;
            input.focus();
            window.scrollTo({ top: 0, behavior: 'smooth' });

            // Fire-and-forget anonymous click tracking (no cookies, no user data)
            try {
              var trackData = JSON.stringify({ question: question, category: category, language: currentLang });
              if (navigator.sendBeacon) {
                navigator.sendBeacon('/api/sample_question_clicks', new Blob([trackData], { type: 'application/json' }));
              } else {
                fetch('/api/sample_question_clicks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: trackData, keepalive: true }).catch(function() {});
              }
            } catch(e) { /* tracking is best-effort */ }

            // Auto-select the matching profile in the Categorie dropdown
            if (category) {
              var profileId = getProfileForCategory(category);
              var profileSelect = document.getElementById('profile-select');
              if (profileSelect && profileSelect.value !== profileId) {
                profileSelect.value = profileId;
                profileSelect.dispatchEvent(new Event('change', { bubbles: true }));
              }
            }

            // Pulse the send button to draw attention
            var sendBtn = document.querySelector('[data-chatbot-target="sendButton"]');
            if (sendBtn) {
              sendBtn.classList.add('ring-4', 'ring-offset-2', 'scale-105');
              sendBtn.style.setProperty('--tw-ring-color', 'var(--accent-400-solid, #60a5fa)');
              setTimeout(function() {
                sendBtn.classList.remove('ring-4', 'ring-offset-2', 'scale-105');
              }, 1500);
            }
          }
        });
      });
    }
    
    // Document-level turbo:load listeners survive Turbo navigations: without
    // deregistration each /chatbot visit stacked another copy, and on
    // non-chatbot pages the handler threw on missing #category-filter.
    if (window._chatbotQuestionsLoadHandler) {
      document.removeEventListener('turbo:load', window._chatbotQuestionsLoadHandler);
    }
    window._chatbotQuestionsLoadHandler = function() {
      // Only act on pages that actually render the questions sidebar
      if (!document.getElementById('questions-list')) return;

      // Load questions - reuse Stimulus-loaded data if available, else fetch
      var loadPromise = window.allQuestions && window.allQuestions.length > 0
        ? Promise.resolve(window.allQuestions)
        : fetch('/chatbot_questions.json').then(function(r) { return r.json(); });

      loadPromise
        .then(function(data) {
          allQuestions = data;
          window.allQuestions = data; // sync both references

          // Populate category filter with PARENT categories only
          // e.g. "ARBEIDSRECHT - INDIVIDUEEL" → "ARBEIDSRECHT"
          var parentCats = [...new Set(data.map(function(q) {
            return q.category.split(' - ')[0].trim();
          }))];
          var select = document.getElementById('category-filter');
          if (!select) return;

          // Clear any existing options (except the "all" option) to prevent duplicates
          while (select.options.length > 1) {
            select.remove(select.options.length - 1);
          }

          // Sort categories alphabetically by their translated display name
          parentCats.sort(function(a, b) {
            var labelA = getCategoryDisplay(a, currentLang);
            var labelB = getCategoryDisplay(b, currentLang);
            return labelA.localeCompare(labelB);
          });
          parentCats.forEach(function(cat) {
            var opt = document.createElement('option');
            opt.value = cat;
            var icon = typeof getIconForCategory === 'function' ? getIconForCategory(cat) : '';
            // Count all questions matching this parent (including subcategories)
            var count = data.filter(function(q) { return q.category === cat || q.category.startsWith(cat + ' - '); }).length;
            opt.textContent = icon + ' ' + getCategoryDisplay(cat, currentLang) + ' (' + count + ')';
            select.appendChild(opt);
          });

          filterQuestions();
        })
        .catch(function(err) {
          var list = document.getElementById('questions-list');
          if (!list) return;
          var t = translations[currentLang] || translations.nl;
          list.innerHTML = '<div class="p-4 text-center text-red-500">' + t.errorLoading + '</div>';
        });
    };
    document.addEventListener('turbo:load', window._chatbotQuestionsLoadHandler);

    // Wire up question filter controls (replaces inline onchange/oninput blocked by CSP)
    var catFilter = document.getElementById('category-filter');
    var qSearch = document.getElementById('question-search');
    if (catFilter) catFilter.addEventListener('change', function() { filterQuestions(); });
    if (qSearch) qSearch.addEventListener('input', function() { filterQuestions(); });

    // ── Sidebar collapse/expand toggle ──
    (function() {
      var sidebar = document.getElementById('sidebar-wrapper');
      var hideBtn = document.getElementById('sidebar-hide-btn');
      var showBtn = document.getElementById('sidebar-show-btn');
      if (!sidebar || !hideBtn || !showBtn) return;

      function collapseSidebar() {
        sidebar.style.width = '0';
        sidebar.style.opacity = '0';
        sidebar.style.overflow = 'hidden';
        sidebar.style.padding = '0';
        sidebar.style.margin = '0';
        sidebar.style.minWidth = '0';
        showBtn.classList.remove('hidden');
        showBtn.classList.add('flex', 'flex-col', 'items-center');
        if (window.prefsStore) window.prefsStore.set('sidebar_state', 'collapsed');
      }

      function expandSidebar() {
        sidebar.style.width = '';
        sidebar.style.opacity = '';
        sidebar.style.overflow = '';
        sidebar.style.padding = '';
        sidebar.style.margin = '';
        sidebar.style.minWidth = '';
        showBtn.classList.add('hidden');
        showBtn.classList.remove('flex', 'flex-col', 'items-center');
        if (window.prefsStore) window.prefsStore.set('sidebar_state', 'expanded');
      }

      hideBtn.addEventListener('click', collapseSidebar);
      showBtn.addEventListener('click', expandSidebar);

      // Restore saved preference (desktop only)
      if (window.innerWidth >= 1024) {
        var savedState = window.prefsStore ? window.prefsStore.get('sidebar_state') : null;
        if (savedState === 'collapsed') {
          collapseSidebar();
        }
      }
    })();
  </script>
