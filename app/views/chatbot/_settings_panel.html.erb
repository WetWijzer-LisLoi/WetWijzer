    <% info_label = case I18n.locale
                    when :fr then 'Plus d’informations'
                    when :de then 'Weitere Informationen'
                    when :en then 'More information'
                    else 'Meer informatie'
                    end %>
    <div class="chatbot-header bg-white dark:bg-[#0f172a] px-4 py-2 border-t border-gray-200 dark:border-[#1e293b]">
      <!-- Hidden language select for JS compatibility -->
      <select id="chatbot-language" class="hidden" data-chatbot-target="languageSelect">
        <option value="nl" selected>Nederlands</option>
      </select>

      <%# ═══════════════════════════════════════════════════════════════════
           TAB STRIP - Intelligence Level Selector
           The tabs sit flush above the settings panel with no bottom border,
           creating a visual connection: active tab → panel below it.
           ═══════════════════════════════════════════════════════════════════ %>
      <%# ═══════════════════════════════════════════════════════════════════
           INTELLIGENCE + REASONING SLIDERS - "Magic Formula" design.
           Horizontal range sliders with notch marks for each level.
           Fun themes → glowing gradients, icons. Professional → clean.
           ═══════════════════════════════════════════════════════════════════ %>
      <% user_is_pro = current_user&.pro? %>
      <% user_has_purchased = current_user&.advanced_intelligence_access? %>
      <% user_model_tier = current_user&.current_tier || :free %>
      <% intelligence_levels = LegalChatbotService::INTELLIGENCE_LEVELS %>
      <% level_keys = intelligence_levels.keys %>
      <% max_unlocked_index = level_keys.each_with_index.select { |id, _i|
           config = intelligence_levels[id]
           tier_accessible = LegalChatbotService.intelligence_tier_accessible?(
             config[:tier], pro: user_is_pro, purchased: user_has_purchased
           )
           tier_accessible && config[:models].keys.any? { |model_id| LegalChatbotService.model_allowed?(model_id, user_model_tier) }
         }.map(&:last).max || 0 %>

      <div id="settings-panel">
        <%= render 'chatbot/research_depth', prefix: 'chatbot', controller_name: 'chatbot', compact: true %>
        <%# One secondary toolbar: settings and the remaining balance (the
            conversation's actions sit above the messages, in
            chatbot/_conversation_actions). The expandable settings body sits
            directly below as part of the same surface. IDs inside the cost
            readout are load-bearing for JS. %>
        <%# The fresh selection's own price (model credits + effort surcharge),
            the same for every account until a saved or explicit choice. %>
        <% default_credits = LegalChatbotService.ui_default_credits %>
        <div class="chat-topbar">
          <button type="button"
                  class="chat-topbar-toggle min-h-9 pl-0 pr-1.5 rounded focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-(--accent-500)"
                  data-action="click->chatbot#toggleSettingsPanel"
                  aria-expanded="false"
                  aria-controls="settings-collapse">
            <span><%= case I18n.locale when :fr then 'Paramètres' when :de then 'Einstellungen' when :en then 'Settings' else 'Instellingen' end %></span>
            <span class="chatbot-settings-caret" aria-hidden="true">›</span>
          </button>

          <div class="chat-topbar-cost" id="cost-summary-bar">
            <%# Credit pools breakdown %>
            <% if logged_in? %>
              <div class="flex items-center gap-3 flex-wrap" id="credit-pools">
  
  
                <%# Credits %>
                <% user_credits = current_user.credits.to_i %>
                  <div class="flex items-center gap-1 group" title="<%= case I18n.locale when :fr then 'Crédits' when :de then 'Credits' when :en then 'Credits' else 'Credits' end %>">
                    <svg class="w-3 h-3 text-gray-400 dark:text-gray-500" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"/><path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"/></svg>
                    <span class="text-sm font-bold <%= user_credits < 5 ? 'text-orange-500 dark:text-orange-400' : 'text-gray-900 dark:text-white' %>" id="credits-value"><%= user_credits %></span>
                    <span class="text-[10px] text-gray-500"><%= case I18n.locale when :fr then 'crédits' when :de then 'Credits' when :en then 'credits' else 'credits' end %></span>
                  </div>
  
                <%# Hidden total for JS animation anchoring %>
                <span class="hidden" id="credits-remaining-value"><%= current_user.total_available_credits %></span>
              </div>
            <% else %>
              <a href="<%= login_path %>" class="flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400 hover:underline">
                <%= t('auth.login') %>
              </a>
            <% end %>
  
          </div>
        </div>
        <%# The bar is closed ABOVE, before the settings body. It used to close
            after it, which made the body a wrapped flex item of the bar: no
            hairline under the bar, the tinted zone inset an extra 1rem, and
            two stacked hairlines of different width beneath it. %>
        <p id="model-availability-notice" role="status" hidden data-preferences-loading-message="<%= t('chatbot.model_preferences_loading_notice') %>" class="px-3 py-1.5 text-xs text-gray-600 dark:text-gray-300"></p>
        <div class="chatbot-settings-body hidden" id="settings-collapse" data-chatbot-target="settingsBody">

        <%# ── Model & Category Row ── %>
        <div class="flex items-center gap-3 flex-wrap pt-2 border-t border-gray-200/50 dark:border-gray-700/30" id="model-controls">
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-medium text-gray-500 dark:text-gray-400" data-translate="model">
              <%= case I18n.locale when :fr then 'Modèle' when :de then 'Modell' when :en then 'Model' else 'Model' end %>:
            </span>
            <span class="relative group cursor-help">
              <span class="text-gray-400 hover:text-[var(--accent-500)] dark:text-gray-500 dark:hover:text-[var(--accent-400)] text-[11px] leading-none relative -top-0.5 transition-colors cursor-help" title="<%= info_label %>">ⓘ</span>
              <div class="absolute bottom-full -left-10 mb-2 px-3 py-2 bg-gray-900 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none w-64 max-w-[calc(100vw-9rem)] z-50 shadow-lg">
                <%= t('chatbot.research_depth.model_explanation') %>
                <div class="absolute top-full left-[41px] border-4 border-transparent border-t-gray-900"></div>
              </div>
            </span>
            <select id="model-select"
                    aria-describedby="model-availability-notice"
                    aria-label="<%= case I18n.locale when :fr then 'Modèle IA' when :de then 'KI-Modell' when :en then 'AI model' else 'AI-model' end %>"
                    data-chatbot-target="modelSelect"
                    data-action="change->chatbot#updateModel"
                    class="text-xs rounded border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 px-1.5 py-0.5">
              <%= render 'chatbot/model_options', user_is_pro: user_is_pro, user_has_purchased: user_has_purchased, user_model_tier: user_model_tier, option_class: 'model-option' %>
            </select>
          </div>
        </div>

        <%# The total stays in the linked model choice, research preview and
            Send button. Keep the internal badge ID for legacy JS updates, but
            do not expose a redundant, unlabeled number visually or to assistive
            technology in the settings panel. %>
        <span hidden aria-hidden="true" id="intelligence-credit-badge"><%= default_credits %></span>

        <!-- Panel Row 2: Category + Sources -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 flex-wrap pt-1.5 border-t border-gray-200/60 dark:border-gray-700/40">
          <!-- Category selector -->
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-medium text-gray-500 dark:text-gray-400" data-translate="profile">
              <%= case I18n.locale when :fr then 'Catégorie' when :de then 'Kategorie' when :en then 'Category' else 'Categorie' end %>:
            </span>
            <span class="relative group cursor-help">
              <span class="text-gray-400 hover:text-[var(--accent-500)] dark:text-gray-500 dark:hover:text-[var(--accent-400)] text-[11px] leading-none relative -top-0.5 transition-colors cursor-help" title="<%= info_label %>">ⓘ</span>
              <div class="absolute bottom-full -left-10 mb-2 px-3 py-2 bg-gray-900 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none w-64 max-w-[calc(100vw-9rem)] z-50 shadow-lg">
                <%= case I18n.locale
                    when :fr then "Choisissez un domaine juridique pour des réponses plus précises."
                    when :de then 'Wählen Sie ein Rechtsgebiet für genauere Antworten.'
                    when :en then 'Choose a legal domain for more targeted answers.'
                    else 'Kies een rechtsdomein voor gerichtere antwoorden.'
                  end %>
                <div class="absolute top-full left-[41px] border-4 border-transparent border-t-gray-900"></div>
              </div>
            </span>
            <select id="profile-select"
                    aria-label="<%= case I18n.locale when :fr then 'Profil juridique' when :de then 'Rechtsprofil' when :en then 'Legal profile' else 'Juridisch profiel' end %>"
                    data-chatbot-target="profileSelect"
                    data-action="change->chatbot#updateProfile"
                    class="text-xs rounded border-gray-300 dark:border-gray-600 dark:bg-gray-900 dark:text-gray-300 px-1.5 py-0.5">
              <% LegalChatbotService::CHATBOT_PROFILES.each do |profile_id, config| %>
                <% name = config[:"name_#{I18n.locale}"] || config[:name_nl] %>
                <option value="<%= profile_id %>" 
                        data-icon="<%= config[:icon] %>"
                        <%= 'selected' if profile_id == 'general' %>>
                  <%= config[:icon] %> <%= name %>
                </option>
              <% end %>
            </select>
          </div>

          <!-- Sources -->
          <div class="flex items-center gap-2">
            <span class="text-xs font-medium text-gray-500 dark:text-gray-400" data-translate="sources">
              <%= case I18n.locale when :fr then 'Sources' when :de then 'Quellen' when :en then 'Sources' else 'Bronnen' end %>:
            </span>
            <span class="relative group cursor-help">
              <span class="text-gray-400 hover:text-[var(--accent-500)] dark:text-gray-500 dark:hover:text-[var(--accent-400)] text-[11px] leading-none relative -top-0.5 transition-colors cursor-help" title="<%= info_label %>">ⓘ</span>
              <div class="absolute bottom-full -left-10 mb-2 px-3 py-2 bg-gray-900 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none w-64 max-w-[calc(100vw-9rem)] z-50 shadow-lg">
                <%= case I18n.locale
                    when :fr then 'Sélectionnez les bases de données juridiques à consulter.'
                    when :de then 'Wählen Sie die juristischen Datenbanken.'
                    when :en then 'Select which legal databases to search.'
                    else 'Kies welke juridische databanken doorzocht worden.'
                  end %>
                <div class="absolute top-full left-[41px] border-4 border-transparent border-t-gray-900"></div>
              </div>
            </span>
            <% pro_sources_locked = !current_user&.pro? %>
            <div class="flex flex-wrap items-center gap-1">
              <label class="source-checkbox inline-flex items-center gap-1 cursor-pointer px-1 py-0.5 rounded hover:bg-(--accent-50,#eff6ff) dark:hover:bg-gray-600 transition-colors">
                <input type="checkbox" 
                       id="source-legislation"
                       data-chatbot-target="sourceLegislation"
                       data-action="change->chatbot#updateSources"
                       checked
                       class="sr-only peer">
                <span class="custom-check"></span>
                <span class="text-xs text-gray-700 dark:text-gray-300" data-translate="legislation">
                  <%= case I18n.locale when :fr then 'Législation' when :de then 'Gesetzgebung' when :en then 'Legislation' else 'Wetgeving' end %>
                </span>
              </label>
              <label class="source-checkbox inline-flex items-center gap-1 px-1 py-0.5 rounded transition-colors <%= pro_sources_locked ? 'cursor-not-allowed opacity-60' : 'cursor-pointer hover:bg-(--accent-50,#eff6ff) dark:hover:bg-gray-600' %>"<%= ' data-action="click->chatbot#handleLockedSource"'.html_safe if pro_sources_locked %>>
                  <input type="checkbox"
                         id="source-jurisprudence"
                         data-chatbot-target="sourceJurisprudence"
                         data-action="change->chatbot#updateSources"
                         <%= 'disabled' if pro_sources_locked %>
                         class="sr-only peer">
                  <span class="custom-check"></span>
                <span class="text-xs text-gray-700 dark:text-gray-300" data-translate="jurisprudence">
                  <%= case I18n.locale when :fr then 'Jurisprudence' when :de then 'Rechtsprechung' when :en then 'Case law' else 'Rechtspraak' end %>
                </span>
                <% if pro_sources_locked %><span class="text-[9px] font-bold text-purple-600 dark:text-purple-300 ml-0.5">PRO</span><% end %>
              </label>
              <label class="source-checkbox inline-flex items-center gap-1 px-1 py-0.5 rounded transition-colors <%= pro_sources_locked ? 'cursor-not-allowed opacity-60' : 'cursor-pointer hover:bg-(--accent-50,#eff6ff) dark:hover:bg-gray-600' %>"<%= ' data-action="click->chatbot#handleLockedSource"'.html_safe if pro_sources_locked %>>
                <input type="checkbox"
                       id="source-parliamentary"
                       data-chatbot-target="sourceParliamentary"
                       data-action="change->chatbot#updateSources"
                         <%= 'disabled' if pro_sources_locked %>
                       class="sr-only peer">
                <span class="custom-check"></span>
                <span class="text-xs text-gray-700 dark:text-gray-300" data-translate="parliamentary">
                  <%= case I18n.locale when :fr then 'Travaux préparatoires' when :de then 'Parlamentarische Vorarbeiten' when :en then 'Parliamentary work' else 'Parlementaire voorbereidingen' end %>
                </span>
                <% if pro_sources_locked %><span class="text-[9px] font-bold text-purple-600 dark:text-purple-300 ml-0.5">PRO</span><% end %>
              </label>
            </div>
          </div>
        </div>
        </div>

      </div>
    </div>
