  .dark .flow-diagram { background: #1e293b; border-color: #334155; }
  .dark .flow-step { background: #1e3a5f; border-color: #3b82f6; color: #e2e8f0; }
  .dark .flow-steps { color: #e2e8f0; }
  .dark .flow-arrow { color: #64748b; }
</style>
