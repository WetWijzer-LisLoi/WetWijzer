<% locale = I18n.locale.to_sym %>
<% tagline = case locale
             when :fr then 'Recherche juridique belge'
             when :de then 'Belgische Rechtsrecherche'
             when :en then 'Belgian legal research'
             else 'Belgische wetgeving helder uitgelegd'
             end %>
<% privacy_label = case locale
                   when :fr then 'Confidentialité'
                   when :de then 'Datenschutz'
                   when :en then 'Privacy'
                   else 'Privacy'
                   end %>
<% terms_label = case locale
                 when :fr then 'Conditions'
                 when :de then 'Bedingungen'
                 when :en then 'Terms'
                 else 'Voorwaarden'
                 end %>
<!doctype html>
<html lang="<%= locale %>">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title><%= site_name %></title>
    <style>
      body,
      table,
      td,
      a {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }

      table,
      td {
        mso-table-lspace: 0;
        mso-table-rspace: 0;
      }

      table {
        border-collapse: collapse !important;
      }

      body {
        height: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
      }

      .ExternalClass {
        width: 100%;
      }

      .ExternalClass,
      .ExternalClass p,
      .ExternalClass span,
      .ExternalClass font,
      .ExternalClass td,
      .ExternalClass div {
        line-height: 100%;
      }

      .content h1,
      .content h2 {
        color: #14213d;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 24px;
        font-weight: 700;
        line-height: 1.25;
        margin: 0 0 18px;
      }

      .content p,
      .content li,
      .content td {
        color: #334155;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 15px;
        line-height: 1.65;
      }

      .content p {
        margin: 0 0 18px;
      }

      .content a {
        color: #1d4ed8;
      }

      .button-wrapper {
        margin: 28px 0;
        text-align: center;
      }

      .button,
      .button-secondary {
        border-radius: 8px;
        display: inline-block;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 15px;
        font-weight: 700;
        line-height: 1.2;
        padding: 14px 28px;
        text-align: center;
        text-decoration: none;
      }

      .button {
        background-color: #2563eb;
        color: #ffffff !important;
      }

      .button-secondary {
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        color: #1e293b !important;
      }

      .info-box,
      .warning-box,
      .success-box,
      .danger-box {
        border: 1px solid #dbe4ef;
        border-left-width: 4px;
        border-radius: 8px;
        margin: 20px 0;
        padding: 15px 17px;
      }

      .info-box {
        background-color: #eff6ff;
        border-left-color: #2563eb;
        color: #1e3a8a;
      }

      .warning-box {
        background-color: #fffbeb;
        border-left-color: #d97706;
        color: #78350f;
      }

      .success-box {
        background-color: #f0fdf4;
        border-left-color: #16a34a;
        color: #14532d;
      }

      .danger-box {
        background-color: #fef2f2;
        border-left-color: #dc2626;
        color: #7f1d1d;
      }

      .info-box p,
      .warning-box p,
      .success-box p,
      .danger-box p {
        color: inherit;
      }

      .divider {
        background-color: #e2e8f0;
        height: 1px;
        margin: 26px 0;
      }

      @media only screen and (max-width: 640px) {
        .outer-cell {
          padding: 12px !important;
        }

        .email-card {
          width: 100% !important;
        }

        .header-cell {
          padding: 20px 22px !important;
        }

        .content {
          padding: 30px 22px !important;
        }

        .footer-cell {
          padding: 20px 22px !important;
        }

        .content h1,
        .content h2 {
          font-size: 22px !important;
        }
      }
    </style>
  </head>
  <body style="background-color: #eef2f7; margin: 0; padding: 0;">
    <% if content_for?(:preheader) %>
      <div style="display: none; font-size: 1px; color: #eef2f7; line-height: 1px; max-height: 0; max-width: 0; opacity: 0; overflow: hidden; mso-hide: all;">
        <%= content_for(:preheader) %>
      </div>
    <% end %>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#eef2f7" style="background-color: #eef2f7; width: 100%;">
      <tr>
        <td class="outer-cell" align="center" style="padding: 32px 16px;">
          <!--[if mso]>
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td>
          <![endif]-->
          <table role="presentation" class="email-card" width="600" cellpadding="0" cellspacing="0" border="0" style="background-color: #ffffff; border: 1px solid #dce4ee; border-radius: 12px; max-width: 600px; overflow: hidden; width: 100%;">
            <tr>
              <td class="header-cell" bgcolor="#0b1f3a" style="background-color: #0b1f3a; border-radius: 11px 11px 0 0; padding: 23px 32px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td width="42" valign="middle" style="width: 42px;">
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td align="center" bgcolor="#2563eb" width="36" height="36" style="background-color: #2563eb; border-radius: 8px; color: #ffffff; font-family: Georgia, 'Times New Roman', serif; font-size: 20px; font-weight: 700; height: 36px; line-height: 36px; text-align: center; width: 36px;">
                            <%= site_name.first %>
                          </td>
                        </tr>
                      </table>
                    </td>
                    <td valign="middle" style="padding-left: 10px;">
                      <p style="color: #ffffff; font-family: Arial, Helvetica, sans-serif; font-size: 19px; font-weight: 700; line-height: 1.15; margin: 0;"><%= site_name %></p>
                      <p style="color: #a9b9cf; font-family: Arial, Helvetica, sans-serif; font-size: 11px; letter-spacing: 0.6px; line-height: 1.35; margin: 4px 0 0; text-transform: uppercase;"><%= tagline %></p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td bgcolor="#2563eb" height="3" style="background-color: #2563eb; font-size: 0; height: 3px; line-height: 3px;">&nbsp;</td>
            </tr>

            <tr>
              <td class="content" bgcolor="#ffffff" style="background-color: #ffffff; color: #334155; font-family: Arial, Helvetica, sans-serif; padding: 38px 38px 34px;">
                <%= yield %>
              </td>
            </tr>

            <tr>
              <td class="footer-cell" bgcolor="#0b1f3a" style="background-color: #0b1f3a; border-radius: 0 0 11px 11px; padding: 20px 32px; text-align: center;">
                <p style="color: #d7e2ef; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 1.5; margin: 0 0 8px;">
                  <a href="<%= site_url %>" style="color: #ffffff; font-weight: 700; text-decoration: none;"><%= site_name %></a>
                  <span style="color: #60758f;">&nbsp;&nbsp;·&nbsp;&nbsp;</span>
                  <a href="<%= "#{site_url}/privacy-policy" %>" style="color: #b9d5ff; text-decoration: none;"><%= privacy_label %></a>
                  <span style="color: #60758f;">&nbsp;&nbsp;·&nbsp;&nbsp;</span>
                  <a href="<%= "#{site_url}/terms-of-service" %>" style="color: #b9d5ff; text-decoration: none;"><%= terms_label %></a>
                </p>
                <p style="color: #8295ad; font-family: Arial, Helvetica, sans-serif; font-size: 11px; line-height: 1.5; margin: 0;">
                  &copy; <%= Date.current.year %> <%= site_name %> &nbsp;·&nbsp; <%= tagline %>
                </p>
              </td>
            </tr>
          </table>
          <!--[if mso]>
          </td></tr></table>
          <![endif]-->
        </td>
      </tr>
    </table>
  </body>
</html>
