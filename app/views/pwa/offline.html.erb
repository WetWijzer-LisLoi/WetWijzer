<% loc = %w[nl fr de en].include?(I18n.locale.to_s) ? I18n.locale.to_s : 'nl' %><!DOCTYPE html>
<html lang="<%= loc %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title><%= t('pwa.offline.title') %></title>
  <link rel="icon" href="/pwa/icon-<%= loc %>-192.png" />
</head>
<body style="margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0f172a;color:#e2e8f0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;">
  <main style="text-align:center;padding:2rem;max-width:26rem;">
    <img src="/pwa/icon-<%= loc %>-192.png" alt="" width="88" height="88" style="border-radius:20px;margin-bottom:1.5rem;" />
    <h1 style="font-size:1.4rem;margin:0 0 .6rem;"><%= t('pwa.offline.title') %></h1>
    <p style="font-size:1rem;line-height:1.5;color:#94a3b8;margin:0 0 1.75rem;"><%= t('pwa.offline.body') %></p>
    <a href="/" style="display:inline-block;background:#3b82f6;color:#fff;text-decoration:none;border-radius:10px;padding:.75rem 1.5rem;font-size:1rem;font-weight:600;"><%= t('pwa.offline.retry') %></a>
  </main>
</body>
</html>
